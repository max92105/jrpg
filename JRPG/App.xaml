<Application x:Class="JRPG.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JRPG"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared UI look: colors and text styles, menu building blocks, placeholder art -->
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Theme.xaml"/>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/MenuStyles.xaml"/>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Art.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
