<UserControl x:Class="JRPG.BattleUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Combat Display Area -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="20">
                <TextBlock x:Name="PlayerName" FontSize="16" Foreground="White" Text="Hero"/>
                <TextBlock x:Name="PlayerHP" FontSize="14" Foreground="LightGreen" Text="HP: 100/100"/>
            </StackPanel>

            <StackPanel Margin="20">
                <TextBlock x:Name="EnemyName" FontSize="16" Foreground="White" Text="Enemy"/>
                <TextBlock x:Name="EnemyHP" FontSize="14" Foreground="Red" Text="HP: 80/80"/>
            </StackPanel>
        </StackPanel>

        <!-- Actions Area -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
            <Button x:Name="AttackButton" Content="Attack" Width="100" Margin="5" Click="AttackButton_Click"/>
            <Button x:Name="DefendButton" Content="Defend" Width="100" Margin="5" Click="DefendButton_Click"/>
            <Button x:Name="RunButton" Content="Run" Width="100" Margin="5" Click="RunButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>