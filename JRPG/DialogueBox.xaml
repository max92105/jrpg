<UserControl x:Class="JRPG.DialogueBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="200" Width="640">

    <Border x:Name="DialogueContainer"
            Background="#AA000000"   
        BorderBrush="White"
            BorderThickness="2"
            Padding="8"
            CornerRadius="10"
            Visibility="Collapsed">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Name Bar -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Speaker Name Bar -->
            <Border Grid.Row="0"
                    Background="#333333"
                    Padding="5,2"
                    CornerRadius="5"
                    Margin="0,0,0,8">
                <TextBlock x:Name="SpeakerName"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="14"
                   FontFamily="Georgia" 
                   HorizontalAlignment="Center"
                   Text=""
                   Visibility="Collapsed"/>
            </Border>

            <!-- Portrait + Dialogue Text -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Portrait -->
                <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True" Background="Black">
                    <Image x:Name="PortraitImage"
                           Width="96"
                           Height="96"
                           Stretch="UniformToFill"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0"/>
                </Border>

                <!-- Text -->
                <TextBlock x:Name="DialogueText"
                           Grid.Column="1"
                           Foreground="White"
                           FontSize="16"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Top"
                           Margin="4,0,0,0"/>

                <TextBlock x:Name="ContinueIndicator"
                           Grid.Column="1"
                           Foreground="White"
                           FontSize="14"
                           FontFamily="Consolas"
                           Text="▶"
                           Visibility="Collapsed"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,10,5"
                           Opacity="0.7"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>