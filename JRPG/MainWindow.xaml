<Window x:Class="JRPG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JRPG"
        xmlns:cutscene="clr-namespace:JRPG.UI.Cutscene"
        xmlns:gamemenu="clr-namespace:JRPG.UI.GameMenu"
        Title="JRPG" Width="1920" Height="1080"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        WindowStyle="None"
        Background="Black">
    <Window.Resources>
        <BlurEffect x:Key="MenuBlurEffect" Radius="10"/>
            <Style x:Key="StartMenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="48" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Cinzel Decorative"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="ContentPresenter"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                  TextBlock.FontWeight="{TemplateBinding FontWeight}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect x:Name="GlowEffect"
                                          Color="White"
                                          BlurRadius="8"
                                          ShadowDepth="0"
                                          Opacity="0.5"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="White"
                                      BlurRadius="15"
                                      ShadowDepth="0"
                                      Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="DropShadow"
                Color="Black"
                Direction="315"
                ShadowDepth="5"
                BlurRadius="15"
                Opacity="0.5"/>
    </Window.Resources>

    <Grid Name="MasterGrid">
        <Grid Name="RootGrid">
            <!-- Lower layers first -->
            <gamemenu:GameMenuControl x:Name="GameMenuControl" />

            <Border
                Background="#AA111111"
                Effect="{DynamicResource DropShadow}"
                x:Name="OverlayViewHost"
                Visibility="Collapsed" Panel.ZIndex="102" Width="1000">
                <!-- Stretch like the in-game menu's content panel, so the save slots get the same size -->
                <ContentPresenter x:Name="ContentOverlayViewHost"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Visibility="Collapsed"
                      Panel.ZIndex="999"/>
            </Border>

            <Canvas x:Name="GameCanvas" Width="1920" Height="1080"
                    Background="Transparent" />

            <cutscene:CutscenePlayer x:Name="CutscenePlayer"
                                     Visibility="Collapsed"
                                     Panel.ZIndex="50" />

            <!-- 🟢 StartScreen moved to TOP of RootGrid -->
            <Grid x:Name="StartScreen" Visibility="Visible" Panel.ZIndex="99">
                <!-- Background image -->
                <Image Name="MenuBackground"
                   Stretch="UniformToFill"
                   Opacity="1"
                   Panel.ZIndex="0" />

                <Grid x:Name="StartMenuContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="*"/>
                        <!-- Menu -->
                    </Grid.RowDefinitions>

                    <!-- Title Text -->
                    <TextBlock Text="The Lost Realm"
                           Grid.Row="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,60,0,0"
                           FontSize="100"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black"
                              BlurRadius="10"
                              ShadowDepth="4"
                              Direction="320"
                              Opacity="0.7"/>
                        </TextBlock.Effect>
                        <TextBlock.FontFamily>
                            <!-- Replace with your custom font path or use an embedded font -->
                            <FontFamily>/Fonts/#Cinzel Decorative</FontFamily>
                        </TextBlock.FontFamily>
                    </TextBlock>

                    <!-- Menu StackPanel -->
                    <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Panel.ZIndex="1">
                        <Button Style="{StaticResource StartMenuButtonStyle}" 
                                Content="Start Game" Margin="0,0,0,20"
                                x:Name="StartButton"
                                Click="StartButton_Click" />

                        <Button Style="{StaticResource StartMenuButtonStyle}" 
                                Content="Load Game" Margin="0,0,0,20"
                                x:Name="LoadButton"
                                Click="LoadButton_Click" />

                        <Button Style="{StaticResource StartMenuButtonStyle}" 
                                Content="Exit Game" Margin="0,0,0,20"
                                x:Name="ExitGame"
                                Click="ExitButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Rectangle x:Name="FadeRect"
                   Fill="Black"
                   Opacity="0"
                   Visibility="Visible"
                   Panel.ZIndex="9999"
                   IsHitTestVisible="False" />

            <local:DialogueBox x:Name="DialogueUI"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,20"
                           Height="120"
                           Width="600"
                           Panel.ZIndex="200" />
        </Grid>
    </Grid>
</Window>