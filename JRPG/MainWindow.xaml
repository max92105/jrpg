<Window x:Class="JRPG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JRPG"
        xmlns:cutscene="clr-namespace:JRPG.UI.Cutscene"
        xmlns:gamemenu="clr-namespace:JRPG.UI.GameMenu"
        Title="JRPG" Width="1024" Height="768"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        WindowStyle="None"       
        Background="Black">
    <Grid Name="MasterGrid">
        <Grid Name="RootGrid">
            <Grid x:Name="StartScreen" Background="Black" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="My JRPG" 
                   Foreground="White" 
                   FontSize="48" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
                    <!-- Margin to add spacing -->

                    <Button Content="Start Game" 
                            x:Name="StartButton"
                            Width="200"
                            Height="50"
                            FontSize="24"
                            HorizontalAlignment="Center"
                            Click="StartButton_Click"/>
                    <Button Content="Load Game" 
                            x:Name="LoadButton"
                            Width="200"
                            Height="50"
                            FontSize="24"
                            HorizontalAlignment="Center"
                            Click="LoadButton_Click"/>
                    <Button Content="Exit Game" 
                            x:Name="ExitGame"
                            Width="200"
                            Height="50"
                            FontSize="24"
                            HorizontalAlignment="Center"
                            Click="ExitButton_Click"/>
                </StackPanel>
            </Grid>

            <gamemenu:GameMenuControl x:Name="GameMenuControl" />
            
            <Canvas x:Name="GameCanvas" Width="1920" Height="1080"
            Background="Transparent" />

            <cutscene:CutscenePlayer x:Name="CutscenePlayer" Visibility="Collapsed" Panel.ZIndex="50"/>
        </Grid>

        <Rectangle Name="FadeRect" Fill="Black" Opacity="0" Visibility="Collapsed"
               Panel.ZIndex="100" IsHitTestVisible="False"/>

        <local:DialogueBox x:Name="DialogueUI"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,20"
                   Height="120"
                   Width="600"
                   Panel.ZIndex="200"/>
    </Grid>
</Window>