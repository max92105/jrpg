<Window x:Class="JRPG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JRPG" Height="680" Width="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Grid Name="MasterGrid">
        <Grid Name="RootGrid">
            <Canvas Name="GameCanvas" Width="640" Height="640" Background="Black" />
        </Grid>

        <Rectangle Name="FadeRect" Fill="Black" Opacity="0" Visibility="Collapsed"
               Panel.ZIndex="100" IsHitTestVisible="False"/>
    </Grid>
</Window>