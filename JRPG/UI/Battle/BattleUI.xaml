<!--
    Battle screen.

    Everything is laid out on a 1920 x 1080 design area (BattleScene), which a Viewbox
    scales to fit the window: same proportions on any screen, nothing goes offscreen.
    The background and dimming layers sit outside it, so they always fill the whole window
    (a screen that isn't 16:9 shows more background instead of black bars).

    Back to front:
      background art + vignette                       (whole window)
      sprites, effects, turn order, party status,
      banner, command menu                            (design area, scaled)
      victory / defeat screen                         (whole window, text scaled)
-->
<UserControl x:Class="JRPG.UI.Battle.BattleUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JRPG.UI.Battle.Controls"
             MouseRightButtonUp="BattleUI_MouseRightButtonUp">
    <Grid>
        <!-- ============ Backdrop (whole window) ============ -->
        <Image x:Name="BattleBackground" Stretch="UniformToFill" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource Brush.BattleVignette}" IsHitTestVisible="False"/>
        <Rectangle Height="320" VerticalAlignment="Top" Fill="{StaticResource Brush.BattleTopShade}" IsHitTestVisible="False"/>

        <!-- ============ Scene (1920 x 1080 design area, scaled to the window) ============ -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="BattleScene" Width="1920" Height="1080">
                <!-- Sprites, enemy tags and target pointers -->
                <Canvas x:Name="SpriteCanvas"/>
                <!-- Damage numbers and attack animations -->
                <Canvas x:Name="EffectCanvas" IsHitTestVisible="False"/>

                <!-- HUD -->
                <controls:TurnOrderBar x:Name="TurnOrder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,0,0"/>

                <!-- Filled with CharacterPanels by UpdateCharacterPanels() -->
                <StackPanel x:Name="CharacterPanelContainer" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,40,0"/>

                <controls:BattleBanner x:Name="Banner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,190,0,0"/>

                <!-- Command menu, moved next to the acting character by UpdateCommandBox() -->
                <Canvas>
                    <controls:CommandPanel x:Name="CommandBox" Visibility="Collapsed" OnCommandSelected="HandleCommandSelected"/>
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- ============ End of battle (dims the whole window, content scaled like the scene) ============ -->
        <Grid x:Name="OutcomeLayer" Background="{StaticResource Brush.Scrim}" Visibility="Collapsed">
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <controls:VictoryScreen x:Name="Victory" Visibility="Collapsed"/>
                    <controls:DefeatScreen x:Name="Defeat" Visibility="Collapsed"/>

                    <!-- Escaped: a short banner, closes by itself or on a click -->
                    <Grid x:Name="EscapedScreen" Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                          MouseLeftButtonUp="EscapedScreen_Click">
                        <Border VerticalAlignment="Center" Background="{StaticResource Brush.Banner}"
                                BorderBrush="{StaticResource Brush.HighlightLine}" BorderThickness="0,1" Padding="0,18">
                            <TextBlock Text="Escaped" Style="{StaticResource Text.Title}" FontSize="64" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>
