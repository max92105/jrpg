<UserControl x:Class="JRPG.CharacterPanel"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="250" Height="100">
    <Border x:Name="PanelBorder" Background="#222" BorderBrush="White" BorderThickness="2" CornerRadius="5" Padding="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Character Portrait -->
            <Image x:Name="PortraitImage" Width="64" Height="64" Margin="5" />

            <!-- Info -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock x:Name="NameText" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="LevelText" Foreground="LightGray" FontSize="12"/>

                <!-- HP -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HP:" Foreground="LightGreen" Width="30"/>
                    <ProgressBar x:Name="HPBar" Width="120" Height="10" Maximum="1"/>
                    <TextBlock x:Name="HPText" Foreground="White" FontSize="10" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- MP -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="MP:" Foreground="LightBlue" Width="30"/>
                    <ProgressBar x:Name="MPBar" Width="120" Height="10" Maximum="1"/>
                    <TextBlock x:Name="MPText" Foreground="White" FontSize="10" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
