<UserControl x:Class="JRPG.UI.Battle.Controls.CharacterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="200" Height="100" Background="Transparent">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HPBarFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6644AA44" Offset="0"/>
            <GradientStop Color="#FF228B22" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MPBarFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8899CCFF" Offset="0"/>
            <GradientStop Color="#FF3366FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RoundedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#222"
                        CornerRadius="6"
                        BorderBrush="Transparent"
                                
                        BorderThickness="0">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Rectangle x:Name="PART_Indicator"
                                   Fill="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Left"
                                   RadiusX="6" RadiusY="6"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PanelTransform"/>
    </UserControl.RenderTransform>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical">

            <!-- Name -->
            <TextBlock x:Name="NameText"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       FontFamily="Source Sans Pro"
                       Margin="0,0,0,4"/>

            <!-- HP Section -->
            <StackPanel Orientation="Vertical" Margin="10,0,0,2">
                <!-- HP Label + Value (aligned left + right) -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                   Text="HP"
                   FontSize="10"
                   FontFamily="Source Sans Pro"
                   Foreground="LightGreen"
                   VerticalAlignment="Bottom"/>

                    <TextBlock x:Name="HPText"
                   Grid.Column="1"
                   FontSize="16"
                   FontWeight="Bold"
                   FontFamily="Source Sans Pro"
                   Foreground="White"
                   HorizontalAlignment="Right"/>
                </Grid>

                <!-- HP Progress Bar -->
                <ProgressBar x:Name="HPBar"
                 Height="6"
                 Maximum="1"
                 Value="0.5"
                 Style="{StaticResource RoundedProgressBarStyle}"
                 Background="#222"
                 Foreground="{StaticResource HPBarFill}"/>
            </StackPanel>

            <!-- MP Section -->
            <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                <!-- Top Row: MP and MPText -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                   Text="MP"
                   FontSize="10"
                   FontFamily="Source Sans Pro"
                   Foreground="LightBlue"
                   VerticalAlignment="Bottom"/>

                    <TextBlock x:Name="MPText"
                   Grid.Column="1"
                   FontSize="16"
                   FontWeight="Bold"
                   FontFamily="Source Sans Pro"
                   Foreground="White"
                   HorizontalAlignment="Right"/>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar x:Name="MPBar"
                 Height="6"
                 Maximum="1"
                 Value="0.25"
                 Style="{StaticResource RoundedProgressBarStyle}"
                 Background="#222"
                 Foreground="{StaticResource MPBarFill}"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
