<!--
    Command menu, shown next to the acting character:

        ◀  Sarxian  ▶            header: whose turn it is
      ┌───────────────────┐
      │ ☛ Attack           │     hovered row glows, with the pointing hand
      │   Skills           │
      │   Items            │
      │   Defend           │
      │   Run              │
      └───────────────────┘
        Strike one enemy…        description of the hovered row

    Skills and Items open their list in place, with a Back row.
-->
<UserControl x:Class="JRPG.UI.Battle.Controls.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360">
    <StackPanel>
        <!-- Header: whose turn it is -->
        <Grid Height="32" Margin="30,0,30,6">
            <Path Data="{StaticResource Shape.BattleHeader}" Stretch="Fill"
                  Fill="{StaticResource Brush.Selection}" Stroke="{StaticResource Brush.Selection.Stroke}" StrokeThickness="1"/>
            <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Body}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Rows: a thin double frame, like the reference -->
        <Border BorderBrush="{StaticResource Brush.Stroke.Strong}" BorderThickness="1" Padding="3" Background="#99000000">
            <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
                <!-- Filled with buttons by ShowCommands / ShowSkills / ShowItems -->
                <StackPanel x:Name="RowsPanel"/>
            </Border>
        </Border>

        <!-- Description of the hovered row, or a short instruction -->
        <Border x:Name="DescriptionBox" Margin="30,6,0,0" Padding="16,10" Visibility="Collapsed"
                Background="#E60C0D11" BorderBrush="{StaticResource Brush.HighlightLine}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="DescriptionText" Style="{StaticResource Text.Body}" FontSize="16" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
