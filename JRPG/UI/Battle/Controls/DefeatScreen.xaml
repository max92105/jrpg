<!--
    Defeat screen, same frame as the victory screen:

      Defeat ───────────────────────────────────────────── (red)
      The party has fallen.
      ◀ ☛ Load a save           ░░░░░                      choices, lit on hover
      ◀   Return to title       ░░░░░
      ──────────────────────────────────────────────────────
      Choose what to do next.                               footer
-->
<UserControl x:Class="JRPG.UI.Battle.Controls.DefeatScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <!-- Title -->
        <Rectangle Style="{StaticResource OutcomeTitleLineStyle}"/>
        <TextBlock x:Name="TitleText" Text="Defeat" Style="{StaticResource OutcomeTitleStyle}"
                   Foreground="{StaticResource Brush.Danger}"/>

        <TextBlock Text="The party has fallen." Style="{StaticResource Text.Secondary}" FontSize="24"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,246,0,0"/>

        <!-- Choices -->
        <StackPanel x:Name="Choices" Width="800" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="88,320,0,0" Opacity="0">
            <Button Content="Load a save" Style="{StaticResource OutcomeChoiceStyle}" Click="LoadSave_Click"/>
            <Button Content="Return to title" Style="{StaticResource OutcomeChoiceStyle}" Click="TitleScreen_Click"/>
        </StackPanel>

        <!-- Bottom line -->
        <Rectangle Height="1" Fill="{StaticResource Brush.Stroke.Strong}" VerticalAlignment="Bottom" Margin="0,0,0,170"/>

        <!-- Footer -->
        <Border Height="100" VerticalAlignment="Bottom" Background="{StaticResource Brush.Bar}"
                BorderBrush="{StaticResource Brush.Stroke.Strong}" BorderThickness="0,1,0,0">
            <TextBlock Text="Choose what to do next." Style="{StaticResource Text.Body}" FontSize="24" Margin="70,0,0,0"/>
        </Border>
    </Grid>
</UserControl>
