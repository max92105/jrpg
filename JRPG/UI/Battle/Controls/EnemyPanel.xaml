<UserControl x:Class="JRPG.UI.Battle.Controls.EnemyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="120" Width="120">
    <Border Background="{Binding PanelBackground}" CornerRadius="6" Padding="6" BorderBrush="DarkRed" BorderThickness="1">
        <StackPanel HorizontalAlignment="Center">
            <Image x:Name="PortraitImage" Width="64" Height="64" Margin="0,0,0,5"/>
            <TextBlock x:Name="EnemyName" Foreground="White" FontWeight="Bold" TextAlignment="Center"/>
            <ProgressBar x:Name="EnemyHPBar" Height="10" Width="100" Minimum="0" Maximum="100" Value="100" Foreground="Red" Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
