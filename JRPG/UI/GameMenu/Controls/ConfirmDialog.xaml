<!-- Yes / no question shown over a page. Use it with:  bool ok = await Dialog.AskAsync("Overwrite?", "Overwrite"); -->
<UserControl x:Class="JRPG.UI.GameMenu.Controls.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid Background="{StaticResource Brush.Scrim}">
        <Border Style="{StaticResource DialogStyle}">
            <StackPanel>
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Heading}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryMenuButtonStyle}" Click="Confirm_Click"/>
                    <Button Content="Cancel" Style="{StaticResource MenuButtonStyle}" Click="Cancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
