<!--
    One line of a menu list:   [icon] [badge] Text   |   [detail icon] Detail   |   Value
    Used for items, equipment slots, equipment choices, skills.
    The Detail column only takes space when Detail is set.
-->
<UserControl x:Class="JRPG.UI.GameMenu.Controls.ListRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="44"
             Background="Transparent">

    <!-- Fade the hover highlight in and out with the mouse -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Selected: stays lit -->
        <Grid x:Name="SelectedHighlight" Visibility="Collapsed">
            <Border Background="{StaticResource Brush.Highlight.Selected}"/>
            <Border BorderBrush="{StaticResource Brush.HighlightLine}" BorderThickness="0,1"/>
        </Grid>

        <!-- Hovered -->
        <Grid x:Name="HoverHighlight" Opacity="0">
            <Border Background="{StaticResource Brush.Highlight}"/>
            <Border BorderBrush="{StaticResource Brush.HighlightLine}" BorderThickness="0,1"/>
        </Grid>

        <Grid Margin="10,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <!-- Icon -->
                <ColumnDefinition Width="*"/>
                <!-- Badge + text -->
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                <!-- Detail -->
                <ColumnDefinition Width="Auto"/>
                <!-- Value -->
            </Grid.ColumnDefinitions>

            <Image x:Name="IconImage" Width="26" Height="26" HorizontalAlignment="Left"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border x:Name="BadgeBorder" Style="{StaticResource BadgeStyle}" Margin="0,0,10,0" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"/>
                </Border>
                <TextBlock x:Name="MainText" Style="{StaticResource Text.Body}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Image x:Name="DetailIconImage" Width="26" Height="26" Margin="0,0,12,0"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource Text.Body}"/>
            </StackPanel>

            <TextBlock x:Name="ValueText" Grid.Column="3" Style="{StaticResource Text.Number}" MinWidth="48"/>
        </Grid>
    </Grid>
</UserControl>
