<UserControl x:Class="JRPG.UI.GameMenu.Controls.MenuHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:JRPG.Utils">
    <Border Style="{StaticResource HeaderBarStyle}">
        <DockPanel Margin="48,0">

            <!-- Right: location + play time -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="LocationGroup" Orientation="Horizontal" Margin="0,0,40,0">
                    <Image Source="{utils:Art Header/Location}" Width="18" Height="18" Opacity="0.7" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LocationText" Style="{StaticResource Text.Secondary}"/>
                </StackPanel>

                <Image Source="{utils:Art Header/PlayTime}" Width="18" Height="18" Opacity="0.7" Margin="0,0,10,0"/>
                <TextBlock x:Name="PlayTimeText" Style="{StaticResource Text.Number}"/>
            </StackPanel>

            <!-- Left: page title -->
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}"/>
        </DockPanel>
    </Border>
</UserControl>
