<!-- One save file:   File 1  |  location / date  |  party portraits -->
<UserControl x:Class="JRPG.UI.GameMenu.Controls.SaveSlotPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="92"
             Background="Transparent">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Thin separator under every file -->
        <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="0,0,0,1"/>

        <Grid x:Name="HoverHighlight" Opacity="0">
            <Border Background="{StaticResource Brush.Highlight}"/>
            <Border BorderBrush="{StaticResource Brush.HighlightLine}" BorderThickness="0,1"/>
        </Grid>

        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <!-- File number -->
                <ColumnDefinition Width="*"/>
                <!-- Location + date -->
                <ColumnDefinition Width="Auto"/>
                <!-- Party -->
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SlotNameText" Style="{StaticResource Text.Heading}"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="LocationText" Style="{StaticResource Text.Body}"/>
                <TextBlock x:Name="TimestampText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Filled with small portraits by SetData -->
            <StackPanel x:Name="PartyPortraitPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
