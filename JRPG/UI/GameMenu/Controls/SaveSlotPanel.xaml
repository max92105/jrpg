<UserControl x:Class="JRPG.UI.GameMenu.Controls.SaveSlotPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="110" Width="Auto">
    <Border CornerRadius="12"
            Background="Transparent"
            BorderBrush="White"
            BorderThickness="1"
            Padding="12"
            Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Info -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="SlotNameText"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="TimestampText"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="MapNameText"
                           FontSize="14"
                           Foreground="LightGray"/>
            </StackPanel>

            <!-- Right: Party Portraits -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10"
                        x:Name="PartyPortraitPanel"/>
        </Grid>
    </Border>
</UserControl>