<!--
    One stat:   [icon] Label ....... 120  ▸ 135
    The arrow and the new value only show while previewing a change.
-->
<UserControl x:Class="JRPG.UI.GameMenu.Controls.StatLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <!-- Icon -->
            <ColumnDefinition Width="*"/>
            <!-- Label -->
            <ColumnDefinition Width="64"/>
            <!-- Current value -->
            <ColumnDefinition Width="28"/>
            <!-- Arrow -->
            <ColumnDefinition Width="64"/>
            <!-- Previewed value -->
        </Grid.ColumnDefinitions>

        <Image x:Name="IconImage" Width="20" Height="20" HorizontalAlignment="Left" Opacity="0.85"/>
        <TextBlock x:Name="LabelText" Grid.Column="1" Style="{StaticResource Text.Body}"/>
        <TextBlock x:Name="ValueText" Grid.Column="2" Style="{StaticResource Text.Number}"/>
        <TextBlock x:Name="ArrowText" Grid.Column="3" Text="▸" Style="{StaticResource Text.Caption}"
                   HorizontalAlignment="Center" Visibility="Hidden"/>
        <TextBlock x:Name="PreviewText" Grid.Column="4" Style="{StaticResource Text.Number}" Visibility="Hidden"/>
    </Grid>
</UserControl>
