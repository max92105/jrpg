<!-- A character's parameters, two per line. Used by the Equipment and Status pages. -->
<UserControl x:Class="JRPG.UI.GameMenu.Controls.StatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JRPG.UI.GameMenu.Controls"
             xmlns:utils="clr-namespace:JRPG.Utils"
             Background="Transparent">
    <UniformGrid Columns="2">
        <controls:StatLine x:Name="MaxHpLine" Label="Max HP" Icon="{utils:Art Stat/HP}" Margin="0,0,40,0"/>
        <controls:StatLine x:Name="MaxMpLine" Label="Max MP" Icon="{utils:Art Stat/MP}"/>
        <controls:StatLine x:Name="AttackLine" Label="Attack" Icon="{utils:Art Stat/Attack}" Margin="0,0,40,0"/>
        <controls:StatLine x:Name="DefenseLine" Label="Defense" Icon="{utils:Art Stat/Defense}"/>
    </UniformGrid>
</UserControl>
