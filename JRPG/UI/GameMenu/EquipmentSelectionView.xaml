<UserControl x:Class="JRPG.UI.GameMenu.EquipmentSelectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/RoundVerticalScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Divider -->
            <RowDefinition Height="*"/>
            <!-- Item List -->
            <RowDefinition Height="Auto"/>
            <!-- Divider line -->
            <RowDefinition Height="Auto"/>
            <!-- Description -->
        </Grid.RowDefinitions>

        <!-- 🏷️ Header: Filter name -->
        <TextBlock 
          Grid.Row="0"
          x:Name="HeaderText"
                 Text=""
                 FontSize="24"
                 FontWeight="Light"
                 Foreground="White"
                 Margin="20"
                 VerticalAlignment="Bottom" />

        <!-- 📑 Table Header Row -->
        <Border Grid.Row="1"
              Background="#333"
              Padding="10,6"
              Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name"
                         Grid.Column="0"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="White"
                         Margin="10,0"/>
                <TextBlock Text="Quantity"
                         Grid.Column="1"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="White"
                         HorizontalAlignment="Right"
                         Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- 📦 Item List -->
        <ScrollViewer Grid.Row="2"
              VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource RoundVerticalScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="ItemListPanel"/>
        </ScrollViewer>

        <!-- 🔻 Divider Line -->
        <Rectangle Grid.Row="3"
                 Height="1"
                 Fill="#666"
                 Margin="0,0"/>

        <!-- 📝 Description -->
        <TextBlock  Grid.Row="4"
                  Margin="20"
                  Height="100"
                  x:Name="ItemDescriptionBlock"
                  FontSize="16"
                  Foreground="White"
                  Text="Hover an item to see its description."
                  TextWrapping="Wrap"/>
    </Grid>
</UserControl>
