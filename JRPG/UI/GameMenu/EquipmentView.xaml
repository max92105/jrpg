<UserControl x:Class="JRPG.UI.GameMenu.EquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid x:Name="MainGrid">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Character Portrait -->
            <StackPanel x:Name="PortraitPanel" Grid.Column="0" VerticalAlignment="Top" Margin="0,75,0,0"/>

            <!-- Right: Content Box -->
            <Border Grid.Column="1"
                    Background="#222"
                    CornerRadius="15"
                    BorderBrush="White"
                    BorderThickness="2"
                    Padding="20">
                <StackPanel>
                    <!-- Header: Name -->
                    <TextBlock x:Name="CharacterNameBlock"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <!-- Divider: Category -->
                    <TextBlock Text="Equipment"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="LightGray"
                               Margin="0,10,0,5"/>

                    <!-- Equipment Selection -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Weapon:" Width="120" Foreground="White"/>
                            <TextBlock x:Name="WeaponNameBlock" Foreground="LightBlue" Cursor="Hand"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Armor:" Width="120" Foreground="White"/>
                            <TextBlock x:Name="ArmorNameBlock" Foreground="LightBlue" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider: Stats -->
                    <TextBlock Text="Stats"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="LightGray"
                               Margin="0,20,0,5"/>

                    <!-- Stats -->
                    <StackPanel x:Name="StatsPanel" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>