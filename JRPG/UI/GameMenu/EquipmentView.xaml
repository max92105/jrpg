<UserControl x:Class="JRPG.UI.GameMenu.EquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JRPG.UI.GameMenu.Controls"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Divider -->
            <RowDefinition Height="*"/>
            <!-- equipment View -->
            <RowDefinition Height="Auto"/>
            <!-- Divider line -->
            <RowDefinition Height="150"/>
            <!-- Stats -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="CharacterNameBlock"
                   FontSize="24"
                   FontWeight="Light"
                   Foreground="White"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="20"
                   Grid.Row="0"/>

        <!-- 📑 Header Row -->
        <Border Grid.Row="1"
                 Background="#333"
                 Padding="10,6">

            <TextBlock Text="Equipment"
                Grid.Column="0"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0"/>
        </Border>

        <!-- Main Content -->
        <StackPanel Grid.Row="2"  Margin="20">
            <!-- Section: Equipment -->
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Weapon" Width="100" Foreground="White"/>
                    <TextBlock x:Name="WeaponNameBlock" Foreground="LightBlue" Cursor="Hand"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Armor" Width="100" Foreground="White"/>
                    <TextBlock x:Name="ArmorNameBlock" Foreground="LightBlue" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 📑 Footer Row -->
        <Border Grid.Row="3"
                 Background="#333"
                 Padding="10,6">

            <TextBlock Text="Statistics"
                Grid.Column="0"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0"/>
        </Border>

        <!-- Section: Stats -->
        <controls:StatsPanel x:Name="cStatsPanel" Grid.Row="4" Margin="20"/>
    </Grid>
</UserControl>