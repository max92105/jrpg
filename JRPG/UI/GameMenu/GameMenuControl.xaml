<UserControl x:Class="JRPG.UI.GameMenu.GameMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JRPG.UI.GameMenu"
             Background="Transparent"
             Visibility="Collapsed"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="MenuToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- ✅ Visual States go here -->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0"
                                                             Duration="0:0:0.30">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12"
                                                             Duration="0:0:0.30">           
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Background Shape -->
                            <Path x:Name="ButtonShape"
                          Stretch="Fill"
                          Fill="#88000000"
                          Stroke="#AA111111"
                          StrokeThickness="1"
                          Data="M 0,0 L 240,0 L 270,25 L 240,50 L 0,50 Z" />

                            <ContentPresenter HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="50,0,0,0"
                                      RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShape" Property="Fill" Value="#CCDDDDDD"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="DropShadow"
                      Color="Black"
                      Direction="315"
                      ShadowDepth="5"
                      BlurRadius="15"
                      Opacity="0.5"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="1000"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Name="MenuBackground"
               Grid.ColumnSpan="3"
           Stretch="Fill"
           Panel.ZIndex="0"
           Opacity="1" />

        <!-- Left Menu -->
        <StackPanel Name="ButtonPanel" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Border Margin="0,20,0,100"
                Effect="{DynamicResource DropShadow}">
                <Grid>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#AA000000" Offset="0.0"/>
                                <!-- Dark start -->
                                <GradientStop Color="#44000000" Offset="0.5"/>
                                <!-- Midpoint -->
                                <GradientStop Color="#00000000" Offset="1.0"/>
                                <!-- Fully transparent -->
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Text on top -->
                    <TextBlock Text="Menu" 
                   Margin="50,10"
                   FontSize="28" 
                   FontWeight="Light" 
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>
                </Grid>
            </Border>

            <ToggleButton Content="Inventory" Style="{StaticResource MenuToggleStyle}" Click="MenuButton_Checked"/>
            <ToggleButton Content="Manage Party" Style="{StaticResource MenuToggleStyle}" Click="MenuButton_Checked"/>
            <ToggleButton Content="Equipment" Style="{StaticResource MenuToggleStyle}" Click="MenuButton_Checked"/>
            <ToggleButton Content="Status" Style="{StaticResource MenuToggleStyle}" Click="MenuButton_Checked"/>
            <ToggleButton Content="Save Game" Style="{StaticResource MenuToggleStyle}" Click="MenuButton_Checked"/>
            <ToggleButton Content="Load Game" Style="{StaticResource MenuToggleStyle}" Click="MenuButton_Checked"/>
            <ToggleButton Content="Options" Style="{StaticResource MenuToggleStyle}" Click="MenuButton_Checked"/>

            <Separator Margin="0,20,0,20" Background="Transparent"/>

            <ToggleButton Content="Return to Game" Style="{StaticResource MenuToggleStyle}" Click="CloseGameMenu_Click"/>
            <ToggleButton Content="Return to Main Menu" Style="{StaticResource MenuToggleStyle}" Click="ReturnToMenuButton_Click"/>
            <ToggleButton Content="Exit Game" Style="{StaticResource MenuToggleStyle}" Click="ExitButton_Click"/>
        </StackPanel>

        <!-- Right Content Panel -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <!-- Context Options Panel -->
                <ColumnDefinition Width="*"/>
                <!-- Main Content Panel -->
            </Grid.ColumnDefinitions>

            <!-- Context Option Buttons -->
            <StackPanel VerticalAlignment="Top" Margin="0,120,0,0" x:Name="ContextOptionsPanel"
                Grid.Column="0"
                HorizontalAlignment="Left" />

            <!-- Submenu Content Panel -->
            <Border Grid.Column="1"
                Background="#AA111111"

                BorderBrush="#44111111"
                BorderThickness="1"
                Effect="{DynamicResource DropShadow}">

                <ContentControl x:Name="GameMenuContent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</UserControl>