<UserControl x:Class="JRPG.UI.GameMenu.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 🌀 Custom ScrollBar Style -->
        <Style x:Key="RoundVerticalScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track"
                           VerticalAlignment="Stretch"
                           IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#CCCCCC"
                                                BorderBrush="#888888"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Width="8" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Divider -->
            <RowDefinition Height="*"/>
            <!-- Item List -->
            <RowDefinition Height="Auto"/>
            <!-- Divider line -->
            <RowDefinition Height="Auto"/>
            <!-- Description -->
        </Grid.RowDefinitions>

        <!-- 🏷️ Header: Filter name -->
        <TextBlock 
            Grid.Row="0"
            x:Name="FilterHeader"
                   Text="All Items"
                   FontSize="24"
                   FontWeight="Light"
                   Foreground="White"
                   Margin="20"
                   VerticalAlignment="Bottom" />

        <!-- 📑 Table Header Row -->
        <Border Grid.Row="1"
                Background="#333"
                Padding="10,6"
                Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name"
                           Grid.Column="0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="10,0"/>
                <TextBlock Text="Quantity"
                           Grid.Column="1"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- 📦 Item List -->
        <ScrollViewer Grid.Row="2"
              VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource RoundVerticalScrollBar}" />
            </ScrollViewer.Resources>

            <StackPanel x:Name="ItemListPanel"/>
        </ScrollViewer>

        <!-- 🔻 Divider Line -->
        <Rectangle Grid.Row="3"
                   Height="1"
                   Fill="#666"
                   Margin="0,10"/>

        <!-- 📝 Description -->
        <TextBlock  Grid.Row="4"
                    Margin="20"
                    Height="100"
                    x:Name="ItemDescriptionBlock"
                    FontSize="16"
                    Foreground="White"
                    Text="Hover an item to see its description."
                    TextWrapping="Wrap"/>

        <Grid x:Name="PopupOverlay"
                Background="#AA000000"
                Visibility="Collapsed"
                Panel.ZIndex="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Border Background="#222"
            CornerRadius="12"
            Padding="20"
            Width="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="White"
            BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="PopupQuestion"
                       Text="Use item?"
                       FontSize="22"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Button Content="Yes" Click="PopupYes_Click" Width="100" Margin="10"/>
                        <Button Content="No" Click="PopupNo_Click" Width="100" Margin="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>