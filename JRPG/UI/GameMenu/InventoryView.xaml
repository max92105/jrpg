<menu:MenuPage x:Class="JRPG.UI.GameMenu.InventoryView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:menu="clr-namespace:JRPG.UI.GameMenu"
                Background="Transparent">
    <menu:MenuPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/RoundVerticalScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </menu:MenuPage.Resources>

    <Grid>
        <Grid Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Category name -->
                <RowDefinition Height="Auto"/>
                <!-- Column headers -->
                <RowDefinition Height="*"/>
                <!-- Item list -->
            </Grid.RowDefinitions>

            <TextBlock x:Name="FilterHeader" Text="All Items" Style="{StaticResource Text.Heading}"/>

            <!-- Column headers (same columns as ListRow) -->
            <Border Grid.Row="1" Style="{StaticResource SectionHeaderStyle}">
                <Grid Margin="10,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource Text.Label}"/>
                    <TextBlock Grid.Column="2" Text="Qty" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Item list: filled with ListRows by Refresh() -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource RoundVerticalScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="ItemListPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Nothing here."
                       Style="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- ============ Use item dialog ============ -->
        <Grid x:Name="PopupOverlay" Background="{StaticResource Brush.Scrim}" Visibility="Collapsed">
            <Border Style="{StaticResource DialogStyle}">
                <StackPanel>
                    <!-- Icon + "Use <item>" -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Image x:Name="PopupIcon" Width="32" Height="32" Margin="0,0,12,0"/>
                        <TextBlock x:Name="PopupQuestion" Style="{StaticResource Text.Heading}"/>
                    </StackPanel>

                    <!-- Who to use it on -->
                    <WrapPanel x:Name="PartyTargetPanel" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PopupYesButton" Content="Use" Style="{StaticResource PrimaryMenuButtonStyle}" Click="PopupYes_Click"/>
                        <Button Content="Cancel" Style="{StaticResource MenuButtonStyle}" Click="PopupNo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</menu:MenuPage>
