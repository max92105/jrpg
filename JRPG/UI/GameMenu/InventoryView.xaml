<UserControl x:Class="JRPG.UI.GameMenu.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- List -->
            <RowDefinition Height="Auto" />
            <!-- Description -->
        </Grid.RowDefinitions>

        <!-- Scrollable list of items -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemListPanel"
                        Margin="0,0,10,0"/>
        </ScrollViewer>

        <!-- Description box -->
        <Border Grid.Row="1"
                BorderBrush="White"
                BorderThickness="2"
                CornerRadius="10"
                Background="#222"
                Padding="10"
                Margin="0,10,0,0">
            <TextBlock x:Name="ItemDescriptionBlock"
                       FontSize="16"
                       Foreground="White"
                       Text="Hover an item to see its description."/>
        </Border>
        <Grid x:Name="PopupOverlay"
      Background="#AA000000"
      Visibility="Collapsed"
      Panel.ZIndex="10"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

            <Border Background="#222"
            CornerRadius="12"
            Padding="20"
            Width="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="White"
            BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="PopupQuestion"
                       Text="Use item?"
                       FontSize="22"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Button Content="Yes" Click="PopupYes_Click" Width="100" Margin="10"/>
                        <Button Content="No" Click="PopupNo_Click" Width="100" Margin="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    
    
</UserControl>