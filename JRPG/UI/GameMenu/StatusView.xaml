<!--
    Status page:
      Name / class / experience            [portrait]
      Parameters (StatsPanel)
      Skills (two columns)
-->
<menu:MenuPage x:Class="JRPG.UI.GameMenu.StatusView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:menu="clr-namespace:JRPG.UI.GameMenu"
               xmlns:controls="clr-namespace:JRPG.UI.GameMenu.Controls"
               Background="Transparent">
    <menu:MenuPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Bars.xaml"/>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/RoundVerticalScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </menu:MenuPage.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Profile -->
            <RowDefinition Height="Auto"/>
            <!-- Parameters -->
            <RowDefinition Height="Auto"/>
            <!-- Skills title -->
            <RowDefinition Height="*"/>
            <!-- Skills -->
        </Grid.RowDefinitions>

        <!-- ============ Profile ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="CharacterNameText" Style="{StaticResource Text.Heading}"/>
                <TextBlock x:Name="ClassText" Style="{StaticResource Text.Caption}"/>

                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Text="Experience" Style="{StaticResource Text.Label}"/>
                </Border>

                <!-- Level | EXP | Next level -->
                <Grid Margin="10,4,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Level" Style="{StaticResource Text.Label}"/>
                    <TextBlock Grid.Column="1" Text="EXP" Style="{StaticResource Text.Label}"/>
                    <TextBlock Grid.Column="2" Text="Next level" Style="{StaticResource Text.Label}"/>

                    <TextBlock x:Name="LevelText" Grid.Row="1" Style="{StaticResource Text.Heading}" FontWeight="Normal"/>
                    <TextBlock x:Name="ExpText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Heading}" FontWeight="Normal"/>
                    <TextBlock x:Name="NextLevelText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Heading}" FontWeight="Normal"/>
                </Grid>

                <ProgressBar x:Name="XpBar" Height="6" Margin="10,12,16,0"
                             Style="{StaticResource RoundedProgressBarStyle}"
                             Foreground="{StaticResource XpBarFill}"/>
            </StackPanel>

            <!-- Portrait -->
            <Border Grid.Column="2" Width="190" Height="190" VerticalAlignment="Top"
                    BorderBrush="{StaticResource Brush.Stroke.Strong}" BorderThickness="1" Background="#33000000">
                <Image x:Name="PortraitImage" Stretch="UniformToFill"/>
            </Border>
        </Grid>

        <!-- ============ Parameters ============ -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource SectionHeaderStyle}">
                <TextBlock Text="Parameters" Style="{StaticResource Text.Label}"/>
            </Border>
            <controls:StatsPanel x:Name="Stats" Margin="10,0,16,0"/>
        </StackPanel>

        <!-- ============ Skills ============ -->
        <Border Grid.Row="2" Style="{StaticResource SectionHeaderStyle}">
            <Grid>
                <TextBlock Text="Skills" Style="{StaticResource Text.Label}"/>
                <TextBlock Text="MP" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource RoundVerticalScrollBar}"/>
            </ScrollViewer.Resources>
            <!-- Filled with ListRows by Refresh() -->
            <UniformGrid x:Name="SkillsPanel" Columns="2" VerticalAlignment="Top"/>
        </ScrollViewer>

        <TextBlock x:Name="NoSkillsText" Grid.Row="3" Text="No skills yet." Style="{StaticResource Text.Secondary}"
                   Margin="10,8,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
    </Grid>
</menu:MenuPage>
