<UserControl x:Class="JRPG.UI.GameMenu.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JRPG.UI.GameMenu.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Bars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Divider -->
            <RowDefinition Height="Auto"/>
            <!-- primary info -->
            <RowDefinition Height="Auto"/>
            <!-- Divider -->
            <RowDefinition Height="*"/>
            <!-- Stats + Details -->
            <RowDefinition Height="Auto"/>
            <!-- Divider -->
            <RowDefinition Height="*"/>
            <!-- Skills -->
        </Grid.RowDefinitions>

        <!-- 🧍 Character Name -->
        <TextBlock x:Name="CharacterNameBlock"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Light"
                   Foreground="White"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="20" />

        <Rectangle Grid.Row="1"
                 Height="1"
                 Fill="#666"
                 Margin="0,0"/>

        <Grid Grid.Row="2" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Labels -->
                <RowDefinition Height="Auto"/>
                <!-- Values -->
                <RowDefinition Height="Auto"/>
                <!-- Xp Bar -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Labels -->
            <TextBlock Text="Level" Grid.Row="0" Grid.Column="0" FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Class" Grid.Row="0" Grid.Column="1" FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Experience" Grid.Row="0" Grid.Column="2" FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="To Next Level" Grid.Row="0" Grid.Column="3" FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- Values -->
            <TextBlock x:Name="LevelBlock" Grid.Row="1" Grid.Column="0" FontSize="18" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ClassBlock" Grid.Row="1" Grid.Column="1" FontSize="18" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CurrentXPBlock" Grid.Row="1" Grid.Column="2" FontSize="18" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="XPToNextLevelBlock" Grid.Row="1" Grid.Column="3" FontSize="18" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>

            <ProgressBar x:Name="XpBar"
                 Grid.Row="2" 
                 Grid.ColumnSpan="4"
                 Height="10"
                 Margin="10"
                 Style="{StaticResource RoundedProgressBarStyle}"
                 Background="#222"
                 Foreground="{StaticResource XpBarFill}"/>
        </Grid>

        <!-- 📑 Divider -->
        <Border Grid.Row="3"
                Background="#333"
                Padding="10,6">
            <TextBlock Text="Statistics"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="10,0"/>
        </Border>

        <!-- 📊 Status Details -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20"
                        x:Name="StatusContentPanel"
                        Background="Transparent">

                <!-- Stats Section -->
                <controls:StatsPanel x:Name="cStatsPanel" Grid.Row="4" Margin="0,10,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="5"
                Background="#333"
                Padding="10,6">
            <TextBlock Text="Skills"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="10,0"/>
        </Border>
        
        <!-- Skills Section -->
        <StackPanel Grid.Row="6" Margin="20" x:Name="SkillsPanel" />
    </Grid>
</UserControl>
