<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="HPBarFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6644AA44" Offset="0"/>
        <GradientStop Color="#FF228B22" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MPBarFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8899CCFF" Offset="0"/>
        <GradientStop Color="#FF3366FF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="RoundedProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#222"
                 CornerRadius="6"
                 BorderBrush="Transparent"
                         
                 BorderThickness="0">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Rectangle x:Name="PART_Indicator"
                            Fill="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left"
                            RadiusX="6" RadiusY="6"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>