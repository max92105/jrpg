<!--
    Look of the battle screen. Colors and text styles come from Theme.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:JRPG.Utils">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/JRPG;component/UI/Styles/Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============ Backdrop ============ -->

    <!-- Darkens the corners of the battle background -->
    <RadialGradientBrush x:Key="Brush.BattleVignette" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#00000000" Offset="0.45"/>
        <GradientStop Color="#B3000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- Darkens the top, so the turn order and party numbers stay readable -->
    <LinearGradientBrush x:Key="Brush.BattleTopShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Soft dark outline behind numbers and names drawn straight on the background -->
    <DropShadowEffect x:Key="Effect.TextOutline" Color="Black" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>

    <!-- ============ Bars ============ -->

    <LinearGradientBrush x:Key="Brush.Bar.HP" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3E7F5A" Offset="0"/>
        <GradientStop Color="#FF7FD39A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Bar.MP" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3E5C9A" Offset="0"/>
        <GradientStop Color="#FF8FB4F0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Victory screen EXP bars: flat warm gold, like the reference -->
    <SolidColorBrush x:Key="Brush.Bar.EXP" Color="#FFE3C17E"/>

    <LinearGradientBrush x:Key="Brush.Bar.EnemyHP" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF8A2A2A" Offset="0"/>
        <GradientStop Color="#FFE0524A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Thin flat bar: track + fill, no rounded ends -->
    <Style x:Key="BattleBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" Background="#80000000">
                        <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Banner (action names, messages) ============ -->

    <LinearGradientBrush x:Key="Brush.Banner" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00101320" Offset="0"/>
        <GradientStop Color="#E6101320" Offset="0.25"/>
        <GradientStop Color="#E6101320" Offset="0.75"/>
        <GradientStop Color="#00101320" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ Victory / defeat ============ -->

    <!-- Darkens the left side only, where the results are; the battle stays visible on the right -->
    <LinearGradientBrush x:Key="Brush.VictoryShade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B3000000" Offset="0"/>
        <GradientStop Color="#66000000" Offset="0.45"/>
        <GradientStop Color="#1A000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Big title, top left: "Victory!" / "Defeat" -->
    <Style x:Key="OutcomeTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="96"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="104,112,0,0"/>
        <Setter Property="Effect" Value="{StaticResource Effect.TextOutline}"/>
    </Style>

    <!-- Thin line under the title, running to the right edge -->
    <Style x:Key="OutcomeTitleLineStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{StaticResource Brush.Stroke.Strong}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="96,226,0,0"/>
    </Style>

    <!-- Long bar with a pointed left end (rewards, defeat choices) -->
    <Geometry x:Key="Shape.RewardBar">M0,32 L30,0 H800 V64 H30 Z</Geometry>
    <LinearGradientBrush x:Key="Brush.RewardBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#99C8CCD4" Offset="0"/>
        <GradientStop Color="#59A8ACB4" Offset="0.6"/>
        <GradientStop Color="#00A8ACB4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Name tab of a party card, pointed at both ends -->
    <Geometry x:Key="Shape.CardHeader">M16,0 H364 L380,21 L364,42 H16 L0,21 Z</Geometry>
    <LinearGradientBrush x:Key="Brush.CardHeader" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E6101014" Offset="0"/>
        <GradientStop Color="#99101014" Offset="1"/>
    </LinearGradientBrush>

    <!-- A defeat choice: a reward bar that lights up blue with the pointing hand -->
    <Style x:Key="OutcomeChoiceStyle" TargetType="Button">
        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path x:Name="Fill" Data="{StaticResource Shape.RewardBar}" Stretch="Fill" Fill="{StaticResource Brush.RewardBar}"/>
                        <Image x:Name="Pointer" Source="{utils:Art Battle/Pointer}" Width="34" Height="34"
                               HorizontalAlignment="Left" Margin="40,0,0,0" Opacity="0"/>
                        <ContentPresenter Margin="96,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="{StaticResource Brush.Selection}"/>
                            <Setter TargetName="Pointer" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Command menu ============ -->

    <!-- Header tab above the command list, pointed at both ends -->
    <Geometry x:Key="Shape.BattleHeader">M16,0 H284 L300,16 L284,32 H16 L0,16 Z</Geometry>

    <!-- One command row. Hovered = blue glow, bright bottom line, pointing hand on the left. -->
    <Style x:Key="BattleCommandStyle" TargetType="Button">
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" Background="#CC0C0D11" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="0,0,0,1"/>
                        <Rectangle x:Name="SelectionLine" Height="2" VerticalAlignment="Bottom"
                                   Fill="{StaticResource Brush.SelectionLine}" Opacity="0"/>
                        <Image x:Name="Pointer" Source="{utils:Art Battle/Pointer}" Width="26" Height="26"
                               HorizontalAlignment="Left" Margin="8,0,0,0" Opacity="0"/>
                        <ContentPresenter Margin="44,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource Brush.Selection}"/>
                            <Setter TargetName="SelectionLine" Property="Opacity" Value="1"/>
                            <Setter TargetName="Pointer" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
