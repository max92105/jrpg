<!--
    The building blocks of the menus: nav tabs, panels, section titles, buttons, cards.
    Colors and text styles come from Theme.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:JRPG.UI.GameMenu.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/JRPG;component/UI/Styles/Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============ Panels ============ -->

    <!-- Translucent dark panel holding a page -->
    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
        <Setter Property="BorderThickness" Value="1,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Top bar (page title, play time) -->
    <Style x:Key="HeaderBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Bar}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Strong}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- Bottom bar (hints, key help) -->
    <Style x:Key="FooterBarStyle" TargetType="Border" BasedOn="{StaticResource HeaderBarStyle}">
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <!-- Section title with an underline fading to the right ("Equipment", "Parameters").
         Also used as the column header above a list (Name ... Qty). -->
    <Style x:Key="SectionHeaderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SectionLine}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,4"/>
        <Setter Property="Margin" Value="0,18,0,6"/>
    </Style>

    <!-- Vertical strip holding the category tabs -->
    <Style x:Key="CategoryRailStyle" TargetType="Border">
        <Setter Property="Background" Value="#80000000"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
        <Setter Property="BorderThickness" Value="1,0"/>
        <Setter Property="Padding" Value="0,12"/>
    </Style>

    <!-- Popup box (Use item?, confirmations) -->
    <Style x:Key="DialogStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Strong}"/>
        <Setter Property="BorderThickness" Value="0,1"/>
        <Setter Property="Padding" Value="40,32"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- One party member (sidebar, party page) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
        <Setter Property="BorderThickness" Value="0,1"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <!-- Small boxed tag next to a name, e.g. "E" for equipped -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- A keyboard key in the footer, e.g. [Esc] -->
    <Style x:Key="KeyHintStyle" TargetType="Border">
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ Nav tabs ============ -->

    <!-- Arrow shapes of a nav tab. Drawn at the exact tab size so the tip never stretches. -->
    <Geometry x:Key="Shape.NavTab">M0,0 H378 L410,28 L378,56 H0 Z</Geometry>
    <Geometry x:Key="Shape.NavTab.Compact">M0,0 H76 L108,28 L76,56 H0 Z</Geometry>

    <!-- Left menu entry: an arrow with icon + label.
         Selected = blue glow with a bright bottom line, content slides right.
         IsCompact = icon only (used while a page is open). -->
    <Style x:Key="NavTabStyle" TargetType="controls:MenuTab">
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Width" Value="410"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MenuTab">
                    <Grid Background="Transparent">
                        <Path x:Name="Shape"
                              Data="{StaticResource Shape.NavTab}"
                              Fill="{StaticResource Brush.Nav}"
                              Stroke="{StaticResource Brush.Nav.Stroke}"
                              StrokeThickness="1"/>
                        <Rectangle x:Name="SelectionLine" Height="2" VerticalAlignment="Bottom" Margin="0,0,32,0"
                                   Fill="{StaticResource Brush.SelectionLine}" Opacity="0"/>

                        <StackPanel x:Name="Content" Orientation="Horizontal" Margin="44,0,0,0" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="Slide"/>
                            </StackPanel.RenderTransform>
                            <Image x:Name="IconImage" Source="{TemplateBinding Icon}" Width="28" Height="28" Opacity="0.75"/>
                            <ContentPresenter x:Name="Label" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{StaticResource Brush.Nav.Hover}"/>
                            <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shape" Property="Fill" Value="{StaticResource Brush.Selection}"/>
                            <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource Brush.Selection.Stroke}"/>
                            <Setter TargetName="SelectionLine" Property="Opacity" Value="1"/>
                            <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="14" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="Shape" Property="Data" Value="{StaticResource Shape.NavTab.Compact}"/>
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Content" Property="Margin" Value="32,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsCompact" Value="True">
                <Setter Property="Width" Value="108"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Entry of a sub menu that unfolds next to a nav tab (System > Save, Load...) -->
    <Style x:Key="SubMenuItemStyle" TargetType="Button">
        <Setter Property="Width" Value="420"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" BorderBrush="{StaticResource Brush.Nav.Stroke}" BorderThickness="0,0,0,1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F0101116" Offset="0"/>
                                    <GradientStop Color="#CC101116" Offset="0.7"/>
                                    <GradientStop Color="#00101116" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Rectangle x:Name="SelectionLine" Height="2" VerticalAlignment="Bottom"
                                   Fill="{StaticResource Brush.SelectionLine}" Opacity="0"/>
                        <ContentPresenter Margin="44,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource Brush.Selection}"/>
                            <Setter TargetName="SelectionLine" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category rail entry: icon only, the label shows as a tooltip -->
    <Style x:Key="CategoryTabStyle" TargetType="controls:MenuTab">
        <Setter Property="GroupName" Value="Category"/>
        <Setter Property="Width" Value="72"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MenuTab">
                    <Grid Background="Transparent">
                        <Border x:Name="Glow" Margin="8,4" Background="{StaticResource Brush.Highlight.Selected}"
                                BorderBrush="{StaticResource Brush.Selection.Stroke}" BorderThickness="1" CornerRadius="4" Opacity="0"/>
                        <Image x:Name="IconImage" Source="{TemplateBinding Icon}" Width="40" Height="40" Opacity="0.5"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="IconImage" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                            <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Buttons ============ -->

    <Style x:Key="MenuButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selection}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Selection.Stroke}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The main choice of a dialog (Use, Overwrite) -->
    <Style x:Key="PrimaryMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
    </Style>
</ResourceDictionary>
