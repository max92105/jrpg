<Window x:Class="MapEditor.Controls.ObjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object Editor" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner" Background="#1A1A1A">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: properties and tools -->
        <DockPanel Grid.Column="0" Margin="12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Save" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
                <Button Content="Cancel" Width="90" IsCancel="True"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Object" Foreground="White" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Name" Foreground="#CCC" Margin="0,8,0,2"/>
                <TextBox x:Name="NameBox"/>
                <TextBlock Text="Category" Foreground="#CCC" Margin="0,8,0,2"/>
                <TextBox x:Name="CategoryBox"/>
                <CheckBox x:Name="IsNpcBox" Content="Is an NPC" Foreground="White" Margin="0,8,0,0"/>

                <TextBlock Text="Draw" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,20,0,4"/>
                <RadioButton x:Name="CollisionToolRadio" GroupName="Tool" Foreground="#7CFC7C" IsChecked="True"
                             Content="Collision (blocks the player)" Checked="Tool_Checked"/>
                <RadioButton x:Name="ZoneToolRadio" GroupName="Tool" Foreground="#6EC8FF" Margin="0,4,0,0"
                             Content="Over the player (leaves, roofs)" Checked="Tool_Checked"/>

                <StackPanel x:Name="ZonePanel" Visibility="Collapsed" Margin="18,8,0,0">
                    <ListBox x:Name="ZoneList" Height="90" SelectionChanged="ZoneList_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="New zone" Width="90" Margin="0,0,6,0" Click="NewZone_Click"/>
                        <Button Content="Delete zone" Width="90" Click="DeleteZone_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Clear shape" Width="90" Margin="0,0,6,0" Click="ClearShape_Click"/>
                    <Button Content="Whole object" Width="90" Click="WholeObject_Click"
                            ToolTip="Replace the shape with a rectangle covering the whole object"/>
                </StackPanel>
                <CheckBox x:Name="SnapBox" Content="Snap to 1/4 tile" Foreground="White" Margin="0,10,0,0"/>

                <TextBlock Foreground="#999" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0">
                    <Run FontWeight="Bold" Foreground="#CCC">How to draw</Run><LineBreak/>
                    Click: add a point (near an edge: insert)<LineBreak/>
                    Drag a point: move it<LineBreak/>
                    Right-click a point: delete it<LineBreak/>
                    Shift+drag: draw a rectangle<LineBreak/>
                    Backspace: remove last point<LineBreak/>
                    Wheel: zoom<LineBreak/><LineBreak/>
                    <Run Foreground="#6EC8FF">Blue zones</Run> are drawn over the player even if the object is on a lower layer.
                    Place trees and houses on the "Same as player" layer so the rest is depth-sorted.
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- RIGHT: drawing surface -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#111">
            <Canvas x:Name="DrawCanvas"
                    Background="#2A2A2A"
                    Margin="40"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp"
                    MouseRightButtonDown="DrawCanvas_MouseRightButtonDown"
                    MouseMove="DrawCanvas_MouseMove"
                    MouseWheel="DrawCanvas_MouseWheel">
                <Canvas.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform"/>
                </Canvas.LayoutTransform>
            </Canvas>
        </ScrollViewer>
    </Grid>
</Window>
