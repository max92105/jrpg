<Window x:Class="MapEditor.EditorMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MapEditor.Controls"
        Title="JRPG Map Editor" WindowState="Maximized" WindowStyle="SingleBorderWindow" Background="#111">
    <DockPanel>
        <!-- MENU -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="_New Map..." InputGestureText="Ctrl+N" Click="NewMap_Click"/>
                <MenuItem Header="_Open Map..." InputGestureText="Ctrl+O" Click="LoadMap_Click"/>
                <Separator/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveMap_Click"/>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveMapAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="_Delete Selected Objects" InputGestureText="Del" Click="DeleteSelected_Click"/>
                <MenuItem Header="_Clear Selection" InputGestureText="Esc" Click="ClearSelection_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ShowGridItem" Header="Show _Grid" IsCheckable="True" IsChecked="True" Click="ViewOption_Click"/>
                <MenuItem x:Name="ToggleCollisionOverlay" Header="Show _Collision and Zones" IsCheckable="True" Click="ViewOption_Click"/>
                <Separator/>
                <MenuItem Header="_Fit Map to View" InputGestureText="Ctrl+0" Click="ResetZoom_Click"/>
                <MenuItem Header="_Actual Size (100%)" InputGestureText="Ctrl+1" Click="ActualSize_Click"/>
            </MenuItem>
            <MenuItem Header="_Map">
                <MenuItem Header="Map _Properties (name, size)..." Click="MapProperties_Click"/>
            </MenuItem>
            <MenuItem Header="_Tiles">
                <MenuItem Header="_Tileset Manager (import sheets, edit tiles)..." InputGestureText="Ctrl+T" Click="TilesetManager_Click"/>
            </MenuItem>
            <MenuItem Header="_Objects">
                <MenuItem Header="_Edit Selected Object (collision, over-player zones)..." Click="EditSelectedObject_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Controls" InputGestureText="F1" Click="ShowControls_Click"/>
            </MenuItem>
        </Menu>

        <!-- TOOLBAR -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0">
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <RadioButton x:Name="TileModeRadio" GroupName="EditorMode" Content="Paint Tiles" Padding="8,2"
                             ToolTip="Left: paint, Right: erase, Alt+click: pick, Shift+click: fill" Checked="TileMode_Checked"/>
                <RadioButton GroupName="EditorMode" Content="Place Objects" Padding="8,2"
                             ToolTip="Left: place, Right/Del: delete, Shift+drag: move, click an NPC: edit it" Checked="ObjectMode_Checked"/>
                <RadioButton GroupName="EditorMode" Content="Triggers" Padding="8,2"
                             ToolTip="Left: add/edit trigger, Right: remove it" Checked="TriggerMode_Checked"/>
                <Separator/>
                <RadioButton GroupName="EditorMode" Content="Tile Z" Padding="8,2"
                             ToolTip="Click a tile to change its layer" Checked="SelectionMode_Checked"/>
                <RadioButton GroupName="EditorMode" Content="Object Part Z" Padding="8,2"
                             ToolTip="Click a part of a placed object to override its layer (this copy only)" Checked="SelectionObjectMode_Checked"/>
            </ToolBar>
            <ToolBar Band="0">
                <TextBlock Text="Layer:" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ComboBox x:Name="LayerPresetBox" Width="230" SelectionChanged="LayerPresetBox_SelectionChanged"/>
                <TextBlock Text="Z:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="LayerInput" Width="40" Text="-5" TextChanged="LayerInput_TextChanged"
                         ToolTip="Any custom layer number"/>
                <Separator/>
                <CheckBox x:Name="DimOtherLayersBox" Content="Dim other layers" Margin="4,0"
                          ToolTip="Fade everything that is not on the current layer"
                          Checked="DimOtherLayers_Changed" Unchecked="DimOtherLayers_Changed"/>
            </ToolBar>
            <!-- Paint Tiles tools (only shown in Paint Tiles mode) -->
            <ToolBar x:Name="TileToolBar" Band="0">
                <TextBlock Text="Tool:" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <RadioButton x:Name="BrushToolRadio" GroupName="TileTool" Content="Brush" Padding="8,2" IsChecked="True"
                             ToolTip="Paint while dragging (B). Right-drag erases." Checked="TileTool_Checked"/>
                <RadioButton x:Name="RectToolRadio" GroupName="TileTool" Content="Rectangle" Padding="8,2"
                             ToolTip="Drag to fill a rectangle (R). Right-drag erases a rectangle." Checked="TileTool_Checked"/>
                <RadioButton x:Name="FillToolRadio" GroupName="TileTool" Content="Fill" Padding="8,2"
                             ToolTip="Click to fill the connected area of the same tile (F). Also Shift+click with any tool." Checked="TileTool_Checked"/>
                <Separator/>
                <TextBlock Text="Size:" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <ComboBox x:Name="BrushSizeBox" Width="50" SelectionChanged="BrushSize_SelectionChanged"
                          ToolTip="Brush size in tiles ( [ and ] to change)">
                    <ComboBoxItem Content="1" IsSelected="True"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="9"/>
                </ComboBox>
                <Separator/>
                <Button Content="Fill layer" Padding="8,2" Click="FillLayer_Click"
                        ToolTip="Fill the whole current layer with the selected tile (undoable)"/>
                <Button Content="Clear layer" Padding="8,2" Click="ClearLayer_Click"
                        ToolTip="Erase every tile on the current layer (undoable)"/>
            </ToolBar>
        </ToolBarTray>

        <!-- STATUS BAR -->
        <Border DockPanel.Dock="Bottom" Background="#202020" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="StatusMessage" DockPanel.Dock="Right" Foreground="#8C8" Margin="20,0,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="#DDD"/>
            </DockPanel>
        </Border>

        <!-- MAIN AREA: map + bottom asset panel -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="360" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- MAP CANVAS -->
            <!-- Camera viewport: the map is moved/zoomed with a transform (no scrollbars).
                 Middle-drag or Space+drag pans, wheel zooms toward the mouse. -->
            <Border x:Name="MapViewport"
                    ClipToBounds="True"
                    Background="#0B0B0B"
                    PreviewMouseDown="MapViewport_PreviewMouseDown"
                    PreviewMouseMove="MapViewport_PreviewMouseMove"
                    PreviewMouseUp="MapViewport_PreviewMouseUp"
                    MouseWheel="MapViewport_MouseWheel"
                    SizeChanged="MapViewport_SizeChanged">
                <Grid x:Name="MapLayerContainer" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas x:Name="MapCanvas"
                            Background="Black"
                            Focusable="True"
                            MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                            MouseRightButtonDown="MapCanvas_MouseRightButtonDown"
                            MouseRightButtonUp="MapCanvas_MouseRightButtonUp"
                            MouseMove="MapCanvas_MouseMove"
                            MouseLeave="MapCanvas_MouseLeave" />
                    <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Drag to resize the bottom panel -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#333" ResizeDirection="Rows"/>

            <!-- BOTTOM PANEL -->
            <Grid Grid.Row="2" Background="#181818">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <!-- Tilesheets / objects list -->
                    <ColumnDefinition Width="*"/>
                    <!-- Asset preview -->
                    <ColumnDefinition Width="300"/>
                    <!-- Properties -->
                </Grid.ColumnDefinitions>

                <!-- Tilesheets (tile mode) or object list (object mode) -->
                <Grid Grid.Column="0">
                    <ListBox x:Name="FolderBrowser"
                             Background="#222"
                             Foreground="White"
                             Visibility="Visible" />

                    <TreeView x:Name="ObjectBrowser"
                              Background="#222"
                              Foreground="White"
                              Visibility="Collapsed"
                              SelectedItemChanged="ObjectBrowser_SelectedItemChanged"/>
                </Grid>

                <!-- Asset preview, with the object-creation tools above the tilesheet -->
                <DockPanel Grid.Column="1">
                    <StackPanel x:Name="TilesheetToolsPanel" DockPanel.Dock="Top" Orientation="Horizontal" Background="#222">
                        <ToggleButton x:Name="ToggleGroupSelection" Content="Select tiles for a new object" Margin="6,4" Padding="8,2"
                                      Checked="ToggleGroupSelection_Checked" Unchecked="ToggleGroupSelection_Checked"
                                      ToolTip="Then click tiles in the sheet below to select the pieces of the object"/>
                        <Button x:Name="CreateObject" Content="Create object from selection" Margin="0,4" Padding="8,2" Click="CreateObject_Click"/>
                        <Button Content="Tileset Manager..." Margin="16,4,0,4" Padding="8,2" Click="TilesetManager_Click"
                                ToolTip="Import tilesheets, set how they are cut, edit tiles"/>
                    </StackPanel>
                    <ContentControl x:Name="AssetPreviewHost" Background="#111"/>
                </DockPanel>

                <!-- Properties -->
                <ScrollViewer x:Name="PropertyPanelContainer" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Properties" Foreground="White" FontWeight="Bold" Margin="10" FontSize="14"/>
                        <controls:PropertyEditor x:Name="PropertyEditorControl" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
