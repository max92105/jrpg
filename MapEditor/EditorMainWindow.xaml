<Window x:Class="MapEditor.EditorMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MapEditor.Controls"
        Title="JRPG Map Editor" WindowState="Maximized" WindowStyle="SingleBorderWindow" Background="#111">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- Left Panel -->
            <ColumnDefinition Width="*"/>
            <!-- Main Area -->
        </Grid.ColumnDefinitions>

        <!-- LEFT: Property Panel -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Editor Mode" Foreground="White" FontWeight="Bold" FontSize="14"/>
            <StackPanel Margin="0,5,0,10">
                <RadioButton Content="Tile" Foreground="White" GroupName="EditorMode" Checked="TileMode_Checked"/>
                <RadioButton Content="Object" Foreground="White" GroupName="EditorMode" Checked="ObjectMode_Checked"/>
                <RadioButton Content="Trigger" Foreground="White" GroupName="EditorMode" Checked="TriggerMode_Checked"/>
                <RadioButton Content="NPC" Foreground="White" GroupName="EditorMode" Checked="NpcMode_Checked"/>
            </StackPanel>

            <TextBlock Text="Layer (Z-Index)" Foreground="White"/>
            <TextBox x:Name="LayerInput" Margin="0,5,0,10" Text="0" TextChanged="LayerInput_TextChanged"/>

            <CheckBox Content="Show Grid" IsChecked="True" Foreground="White" Checked="GridToggle_Checked" Unchecked="GridToggle_Checked"  Margin="5"/>
            <CheckBox x:Name="ToggleCollisionOverlay"  Foreground="White"
          Content="Show Collision"
          Margin="5"
          Checked="ToggleCollisionOverlay_Checked"
          Unchecked="ToggleCollisionOverlay_Checked"/>
            <CheckBox x:Name="ToggleGroupSelection"
                Content="Group Selection"  Foreground="White"
                Margin="5"
                Checked="ToggleGroupSelection_Checked"
                Unchecked="ToggleGroupSelection_Checked"/>
            <Button Name="CreateObject" Content="Create Object" Click="CreateObject_Click" />

            <TextBlock Text="Map Name" Foreground="White"/>
            <TextBox x:Name="MapNameBox" Margin="0,5,0,10" Text="New Map" TextChanged="MapNameBox_TextChanged"/>

            <TextBlock Text="Map Size" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <TextBox x:Name="MapWidthBox" Width="50" Margin="0,0,5,0" Text="30"/>
                <TextBox x:Name="MapHeightBox" Width="50" Text="17"/>
            </StackPanel>
            <Button Content="Apply Size" Click="ApplySize_Click" Margin="0,0,0,10"/>

            <Button Content="Load Map" Click="LoadMap_Click" Margin="0,5,0,5"/>
            <Button Content="Save Map" Click="SaveMap_Click" Margin="0,5,0,5"/>
            <Button Content="Exit" Click="Exit_Click" Margin="0,20,0,0"/>
        </StackPanel>

        <!-- RIGHT: Main Area (Canvas + Bottom Panel) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- Map canvas -->
                <RowDefinition Height="400" />
                <!-- Bottom panel -->
            </Grid.RowDefinitions>

            <!-- MAP CANVAS -->
            <ScrollViewer x:Name="MapScrollViewer"
                  Grid.Row="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="MapCanvas"
                Background="Black"
                Focusable="True"
                MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                MouseMove="MapCanvas_MouseMove"
                MouseWheel="MapCanvas_MouseWheel"
                RenderTransformOrigin="0,0">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                    </Canvas.RenderTransform>
                </Canvas>
            </ScrollViewer>

            <!-- BOTTOM PANEL -->
            <Grid Grid.Row="1" Background="#181818">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <!-- Folder nav -->
                    <ColumnDefinition Width="*"/>
                    <!-- Asset preview -->
                    <ColumnDefinition Width="300"/>
                    <!-- Item properties -->
                </Grid.ColumnDefinitions>

                <!-- Folder navigation -->
                <Grid Grid.Column="0">
                    <ListBox x:Name="FolderBrowser"
                                Background="#222"
                                Foreground="White"
                                Visibility="Visible" />

                    <TreeView x:Name="ObjectBrowser"
                              Background="#222"
                              Foreground="White"
                              Visibility="Collapsed"
                              SelectedItemChanged="ObjectBrowser_SelectedItemChanged"/>
                </Grid>

                <!-- Asset preview -->
                <ContentControl x:Name="AssetPreviewHost" Grid.Column="1" Background="#111"/>

                <!-- Item properties -->
                <ScrollViewer  x:Name="PropertyPanelContainer" Grid.Column="2" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Item Properties" Foreground="White" FontWeight="Bold" Margin="10" FontSize="14"/>
                        <controls:PropertyEditor x:Name="PropertyEditorControl" Grid.Column="2" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>