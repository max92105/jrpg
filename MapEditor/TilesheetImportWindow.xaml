<Window x:Class="MapEditor.TilesheetImportWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Tilesheet" Height="700" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="TilesheetCanvas" Background="Black"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
            <TextBlock Text="Name Prefix:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="NamePrefixBox" Width="100" Text="Tile"/>
            <CheckBox x:Name="WalkableCheck" Content="Walkable" Margin="20,0"/>
            <Button Content="Add All" Width="100" Margin="20,0" Click="AddAll_Click"/>
            <Button Content="Cancel" Width="100" Margin="10,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>