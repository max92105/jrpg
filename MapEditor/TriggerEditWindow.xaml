<Window x:Class="MapEditor.TriggerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Trigger" Height="300" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel>
            <ComboBox x:Name="TriggerTypeBox" SelectionChanged="TriggerTypeBox_SelectionChanged">
                <ComboBoxItem Content="Warp" Tag="Warp"/>
                <ComboBoxItem Content="Dialogue" Tag="Dialogue"/>
                <ComboBoxItem Content="Item" Tag="Item"/>
            </ComboBox>

            <!-- Warp Panel -->
            <StackPanel x:Name="WarpPanel" Visibility="Collapsed" Margin="5">
                <TextBlock Text="Target Map:"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="WarpMapBox" Width="200" IsReadOnly="True" Margin="0,0,5,0"/>
                    <Button Content="..." Width="25" Click="SelectMapFile_Click"/>
                </StackPanel>
                <TextBlock Text="Target X,Y:"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="WarpXBox" Width="50" Margin="0,0,5,0"/>
                    <TextBox x:Name="WarpYBox" Width="50"/>
                </StackPanel>
            </StackPanel>

            <!-- Dialogue Panel -->
            <StackPanel x:Name="DialoguePanel" Visibility="Collapsed" Margin="10">
                <TextBlock Text="Speaker Name:" Margin="0,0,0,5"/>
                <TextBox x:Name="DialogueSpeakerBox" Margin="0,0,0,10"/>

                <TextBlock Text="Portrait:" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="DialoguePortraitBox" Width="200" IsReadOnly="True" Margin="0,0,5,0"/>
                    <Button Content="..." Width="25" Click="SelectPortrait_Click"/>
                </StackPanel>

                <TextBlock Text="Dialogue Pages:" Margin="0,0,0,5"/>
                <ListBox x:Name="DialogueLinesBox" Height="100" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NewDialogueLineBox" Width="200" Margin="0,0,5,0"/>
                    <Button Content="Add" Width="50" Click="AddDialogueLine_Click"/>
                    <Button Content="Remove Selected" Width="120" Click="RemoveDialogueLine_Click" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Item Panel -->
            <StackPanel x:Name="ItemPanel" Visibility="Collapsed" Margin="5">
                <TextBlock Text="Item Name:"/>
                <TextBox x:Name="ItemBox"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="OK" Click="Ok_Click" Width="75" Margin="0,0,10,0"/>
                <Button Content="Cancel" Click="Cancel_Click" Width="75"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>