<Application x:Class="JRPG.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JRPG"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared UI look. Art comes before the styles, since some styles use art. -->
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Theme.xaml"/>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Art.xaml"/>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/MenuStyles.xaml"/>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/BattleStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
