<!-- Ribbon at the top of the battle: the name of the skill / item being used, or a short message. -->
<UserControl x:Class="JRPG.UI.Battle.Controls.BattleBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0" IsHitTestVisible="False">
    <Border Background="{StaticResource Brush.Banner}" BorderBrush="{StaticResource Brush.HighlightLine}"
            BorderThickness="0,1" Padding="120,10" MinWidth="560">
        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center"/>
    </Border>
</UserControl>
