<!--
    One party member, top right of the battle:

                         Name   ◆
             HP 2673 /2673
             ─────────────────
                  MP 146 /146
                  ────────────

    The MP row is narrower, so the rows step like in the reference.
    The acting member slides left and its diamond lights up.
-->
<UserControl x:Class="JRPG.UI.Battle.Controls.CharacterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JRPG.UI.Battle.Controls"
             Width="400" Margin="0,0,0,14" IsHitTestVisible="False">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PanelSlide"/>
    </UserControl.RenderTransform>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Name and stats -->
            <ColumnDefinition Width="Auto"/>
            <!-- Diamond portrait -->
        </Grid.ColumnDefinitions>

        <StackPanel Effect="{StaticResource Effect.TextOutline}" Margin="0,0,10,0">
            <TextBlock x:Name="NameText" Style="{StaticResource Text.Heading}" HorizontalAlignment="Right"/>

            <!-- HP -->
            <StackPanel Width="250" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="HP" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="0,0,10,5"/>
                    <TextBlock x:Name="HPText" Style="{StaticResource Text.Number}" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MaxHPText" Style="{StaticResource Text.Number}" FontSize="17" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                </StackPanel>
                <ProgressBar x:Name="HPBar" Style="{StaticResource BattleBarStyle}" Foreground="{StaticResource Brush.Bar.HP}"/>
            </StackPanel>

            <!-- MP -->
            <StackPanel Width="190" HorizontalAlignment="Right" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="MP" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="0,0,10,4"/>
                    <TextBlock x:Name="MPText" Style="{StaticResource Text.Number}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MaxMPText" Style="{StaticResource Text.Number}" FontSize="15" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                </StackPanel>
                <ProgressBar x:Name="MPBar" Style="{StaticResource BattleBarStyle}" Foreground="{StaticResource Brush.Bar.MP}"/>
            </StackPanel>
        </StackPanel>

        <controls:TurnPortrait x:Name="Portrait" Grid.Column="1" Width="64" Height="64" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
