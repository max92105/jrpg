<!--
    One party member on the victory screen:

       Level Up!                          (pops in when the level goes up)
      ◀ Sarxian              Lv.11 ▶      name tab
        EXP               3,733/5,054
        ━━━━━━━━━━━━━━━━░░░░░░░░░░░       gold bar
        Next                    1,321
        ──────────────────────────────
-->
<UserControl x:Class="JRPG.UI.Battle.Controls.ExpGainRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Opacity="0">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="AppearSlide" X="-30"/>
    </UserControl.RenderTransform>

    <StackPanel Effect="{StaticResource Effect.TextOutline}">
        <!-- Name tab -->
        <Grid Height="42">
            <Path Data="{StaticResource Shape.CardHeader}" Stretch="Fill"
                  Fill="{StaticResource Brush.CardHeader}" Stroke="{StaticResource Brush.Stroke}" StrokeThickness="1"/>

            <TextBlock x:Name="NameText" Style="{StaticResource Text.Body}" FontSize="26" Margin="22,0,0,0" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,24,0">
                <TextBlock Text="Lv." Style="{StaticResource Text.Body}" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                <TextBlock x:Name="LevelText" Style="{StaticResource Text.Body}" FontSize="24" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="LevelPop"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- Above the tab's right end -->
            <TextBlock x:Name="LevelUpText" Text="Level Up!" FontFamily="{StaticResource Font.Ui}" FontSize="26"
                       FontStyle="Italic" FontWeight="SemiBold" Foreground="{StaticResource Brush.Positive}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-34,8,0"
                       Opacity="0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="LevelUpPop"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

        <!-- EXP: current / needed -->
        <Grid Margin="16,6,16,0">
            <TextBlock Text="EXP" Style="{StaticResource Text.Label}" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ExpText" Style="{StaticResource Text.Number}" FontSize="30"/>
                <TextBlock x:Name="MaxExpText" Style="{StaticResource Text.Number}" FontSize="20"
                           Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="ExpBar" Style="{StaticResource BattleBarStyle}" Height="14" Margin="16,4,16,0"
                     Foreground="{StaticResource Brush.Bar.EXP}" ValueChanged="ExpBar_ValueChanged"/>

        <!-- EXP still needed, on an underline -->
        <Border Margin="16,8,16,0" Padding="0,0,0,2" BorderBrush="{StaticResource Brush.Stroke.Strong}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Next" Style="{StaticResource Text.Label}" FontSize="16"/>
                <TextBlock x:Name="NextLevelText" Style="{StaticResource Text.Number}" FontSize="22"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
