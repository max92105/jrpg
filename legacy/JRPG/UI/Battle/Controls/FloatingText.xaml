<!-- Damage / heal number that pops over a target, rises and fades. -->
<UserControl x:Class="JRPG.UI.Battle.Controls.FloatingText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160" Height="60" Background="Transparent" IsHitTestVisible="False">
    <TextBlock x:Name="TextLabel"
               FontFamily="{StaticResource Font.Ui}"
               FontSize="40"
               FontWeight="Bold"
               Typography.NumeralAlignment="Tabular"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Effect="{StaticResource Effect.TextOutline}"/>
</UserControl>
