<UserControl x:Class="JRPG.UI.GameMenu.Controls.CharacterPortrait"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Bars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Border" x:Key="SelectionPulse">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0.5" Duration="0:0:0.6" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <Grid Width="48" Height="48">
            <Image x:Name="PortraitImage"
                   Stretch="UniformToFill"
                   SnapsToDevicePixels="True" />
        </Grid>

        <ProgressBar x:Name="HPBar"
                     Width="48"
                     Height="4"
                     Margin="0,2,0,0"
                     Style="{StaticResource RoundedProgressBarStyle}"
                     Foreground="{StaticResource HPBarFill}"/>

        <ProgressBar x:Name="MPBar"
                     Width="48"
                     Height="4"
                     Margin="0,1,0,0"
                     Style="{StaticResource RoundedProgressBarStyle}"
                     Foreground="{StaticResource MPBarFill}"/>
    </StackPanel>
</UserControl>