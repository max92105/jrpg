<UserControl x:Class="JRPG.UI.GameMenu.Controls.PartyMemberCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/Bars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <!-- Portrait -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Name, class, HP / MP -->
                </Grid.ColumnDefinitions>

                <!-- Portrait -->
                <Border Width="80" Height="80"
                        BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                        Background="#33000000">
                    <Image x:Name="PortraitImage" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <!-- Name [Leader] ........ Lv 10 -->
                    <DockPanel>
                        <TextBlock x:Name="LevelText" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NameText" Style="{StaticResource Text.Heading}"/>
                            <Border x:Name="LeaderBadge" Style="{StaticResource BadgeStyle}" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="Leader" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ClassText" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>

                    <!-- HP / MP bars -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="HP" Style="{StaticResource Text.Label}"/>
                        <ProgressBar x:Name="HPBar" Grid.Column="1" Height="6"
                                     Style="{StaticResource RoundedProgressBarStyle}"
                                     Foreground="{StaticResource HPBarFill}"/>
                        <TextBlock x:Name="HPText" Grid.Column="2" Style="{StaticResource Text.Number}" FontSize="15"/>

                        <TextBlock Grid.Row="1" Text="MP" Style="{StaticResource Text.Label}"/>
                        <ProgressBar x:Name="MPBar" Grid.Row="1" Grid.Column="1" Height="6"
                                     Style="{StaticResource RoundedProgressBarStyle}"
                                     Foreground="{StaticResource MPBarFill}"/>
                        <TextBlock x:Name="MPText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Number}" FontSize="15"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hover highlight, only when the card is clickable (see IsInteractive) -->
        <Grid x:Name="HoverHighlight" Opacity="0" IsHitTestVisible="False">
            <Border Background="{StaticResource Brush.Highlight}"/>
            <Border BorderBrush="{StaticResource Brush.HighlightLine}" BorderThickness="0,1"/>
        </Grid>
    </Grid>
</UserControl>
