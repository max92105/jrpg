<!--
    Equipment picker, shown on the right of the Equipment page:
      Weapon
      Name ............ Qty
      Remove
      [E] Bronze Sword    1     (E = worn by this character)
      Iron Sword          1
      Equipped by: [portraits]
-->
<UserControl x:Class="JRPG.UI.GameMenu.EquipmentSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/RoundVerticalScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Slot name -->
            <RowDefinition Height="Auto"/>
            <!-- Column headers -->
            <RowDefinition Height="*"/>
            <!-- Choices -->
            <RowDefinition Height="Auto"/>
            <!-- Equipped by -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Heading}"/>

        <Border Grid.Row="1" Style="{StaticResource SectionHeaderStyle}">
            <Grid Margin="10,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="2" Text="Qty" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource RoundVerticalScrollBar}"/>
            </ScrollViewer.Resources>
            <!-- Filled with ListRows by BuildList() -->
            <StackPanel x:Name="EquipmentListPanel"/>
        </ScrollViewer>

        <!-- Who already wears the hovered item (click one to take it from them) -->
        <StackPanel x:Name="EquippedBySection" Grid.Row="3" Visibility="Collapsed">
            <Border Style="{StaticResource SectionHeaderStyle}">
                <TextBlock Text="Equipped by" Style="{StaticResource Text.Label}"/>
            </Border>
            <WrapPanel x:Name="EquippedByPanel"/>
        </StackPanel>
    </Grid>
</UserControl>
