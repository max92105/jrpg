<!--
    Equipment page:
      Name
      Equipment    [slot] Weapon   [item] Bronze Sword
                   [slot] Armor    [item] Leather Armor
                   Remove all
      Parameters   Max HP 300   Max MP 300
                   Attack  20 ▸ 23   Defense 11
    Clicking a slot opens the EquipmentSelectionView picker on the right.
-->
<menu:MenuPage x:Class="JRPG.UI.GameMenu.EquipmentView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:menu="clr-namespace:JRPG.UI.GameMenu"
               xmlns:controls="clr-namespace:JRPG.UI.GameMenu.Controls"
               xmlns:utils="clr-namespace:JRPG.Utils"
               Background="Transparent">
    <StackPanel Margin="28,20">
        <TextBlock x:Name="CharacterNameText" Style="{StaticResource Text.Heading}"/>

        <!-- Slots -->
        <Border Style="{StaticResource SectionHeaderStyle}">
            <TextBlock Text="Equipment" Style="{StaticResource Text.Label}"/>
        </Border>
        <controls:ListRow x:Name="WeaponSlot" Text="Weapon" Icon="{utils:Art Slot/Weapon}" IsClickable="True"
                          MouseLeftButtonUp="WeaponSlot_Click"/>
        <controls:ListRow x:Name="ArmorSlot" Text="Armor" Icon="{utils:Art Slot/Armor}" IsClickable="True"
                          MouseLeftButtonUp="ArmorSlot_Click"/>

        <!-- Actions -->
        <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="0,1,0,0" Margin="0,10,0,0"/>
        <controls:ListRow Text="Remove all" Icon="{utils:Art Action/RemoveAll}" IsClickable="True"
                          MouseLeftButtonUp="RemoveAll_Click"/>

        <!-- Parameters -->
        <Border Style="{StaticResource SectionHeaderStyle}">
            <TextBlock Text="Parameters" Style="{StaticResource Text.Label}"/>
        </Border>
        <controls:StatsPanel x:Name="Stats" Margin="10,0,16,0"/>
    </StackPanel>
</menu:MenuPage>
