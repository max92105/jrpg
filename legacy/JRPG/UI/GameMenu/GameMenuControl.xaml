<!--
    The in-game menu shell.

    No page open (main menu):           A page open:
    ┌ Header: Menu ──────────────┐      ┌ Header: Equipment ─────────────────────────────┐
    │ ▶ Inventory                │      │ ▶ │ rail │ Page (GameMenuContent) │ Party or  │
    │ ▶ Party                    │      │ ▶ │      │                        │ secondary │
    │ ▶ ...                      │      │ ▶ │      │                        │ panel     │
    └ Footer: hint ──── [Esc] ───┘      └ Footer: hint ─────────────────────── [Esc] ────┘

    The nav tabs shrink to icons while a page is open.
    Pages are MenuPages (InventoryView, StatusView...) shown in GameMenuContent.
-->
<UserControl x:Class="JRPG.UI.GameMenu.GameMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JRPG.UI.GameMenu.Controls"
             xmlns:utils="clr-namespace:JRPG.Utils"
             Background="Transparent"
             Visibility="Collapsed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Body -->
            <RowDefinition Height="64"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Background art, darkened at the edges -->
        <Image x:Name="MenuBackground" Grid.RowSpan="3" Stretch="UniformToFill"/>
        <Rectangle Grid.RowSpan="3" Fill="{StaticResource Brush.MenuScrim}"/>

        <!-- ============ Header ============ -->
        <controls:MenuHeader x:Name="Header" Grid.Row="0"/>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1" Margin="0,40,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Nav tabs -->
                <ColumnDefinition Width="Auto"/>
                <!-- Category rail -->
                <ColumnDefinition Width="*"/>
                <!-- Page -->
                <ColumnDefinition Width="Auto"/>
                <!-- Party sidebar / secondary panel -->
            </Grid.ColumnDefinitions>

            <!-- Nav tabs -->
            <StackPanel x:Name="NavPanel" Grid.Column="0">
                <controls:MenuTab Content="Inventory" Icon="{utils:Art Menu/Inventory}" Style="{StaticResource NavTabStyle}" Click="Inventory_Click"/>
                <controls:MenuTab Content="Party" Icon="{utils:Art Menu/Party}" Style="{StaticResource NavTabStyle}" Click="Party_Click"/>
                <controls:MenuTab Content="Equipment" Icon="{utils:Art Menu/Equipment}" Style="{StaticResource NavTabStyle}" Click="Equipment_Click"/>
                <controls:MenuTab Content="Status" Icon="{utils:Art Menu/Status}" Style="{StaticResource NavTabStyle}" Click="Status_Click"/>
                <controls:MenuTab x:Name="SystemTab" Content="System" Icon="{utils:Art Menu/System}" Style="{StaticResource NavTabStyle}" Click="System_Click"/>
            </StackPanel>

            <!-- Category rail: filters for the current page (item types, characters...) -->
            <Border x:Name="CategoryRail" Grid.Column="1" Width="72" Margin="12,0,0,0" Style="{StaticResource CategoryRailStyle}">
                <StackPanel x:Name="CategoryPanel"/>
            </Border>

            <!-- Page, with its icon as a faint watermark in the corner -->
            <Border x:Name="ContainerGameMenuContent" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource GlassPanelStyle}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PageSlide"/>
                </Border.RenderTransform>
                <Grid>
                    <Image x:Name="PageWatermark" Width="110" Height="110" Opacity="0.08"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0"
                           IsHitTestVisible="False"/>
                    <ContentControl x:Name="GameMenuContent"/>
                </Grid>
            </Border>

            <!-- Right side: the party, or a secondary panel (e.g. the equipment picker) -->
            <controls:PartySidebar x:Name="PartySidebar" Grid.Column="3" Width="460" Margin="24,0,0,0"/>

            <Border x:Name="SecondaryPanelContainer" Grid.Column="3" Width="560" Margin="12,0,0,0"
                    Style="{StaticResource GlassPanelStyle}" Visibility="Collapsed">
                <ContentControl x:Name="SecondaryPanel"/>
            </Border>

            <!-- ============ System sub menu: unfolds next to the System tab ============ -->

            <!-- Invisible layer: clicking anywhere outside the sub menu closes it -->
            <Rectangle x:Name="SubMenuDismissLayer" Grid.Column="1" Grid.ColumnSpan="3" Fill="Transparent"
                       Visibility="Collapsed" MouseLeftButtonDown="SubMenuDismissLayer_Click"/>

            <Canvas x:Name="SubMenuLayer" Grid.ColumnSpan="4">
                <StackPanel x:Name="SystemSubMenu" Visibility="Collapsed">
                    <Button Content="Save" Style="{StaticResource SubMenuItemStyle}" Click="Save_Click"/>
                    <Button Content="Load" Style="{StaticResource SubMenuItemStyle}" Click="Load_Click"/>
                    <Button Content="Options" Style="{StaticResource SubMenuItemStyle}" Click="Options_Click"/>
                    <Button Content="Title Screen" Style="{StaticResource SubMenuItemStyle}" Click="TitleScreen_Click"/>
                    <Button Content="Quit Game" Style="{StaticResource SubMenuItemStyle}" Click="Quit_Click"/>
                </StackPanel>
            </Canvas>
        </Grid>

        <!-- ============ Footer ============ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBarStyle}">
            <DockPanel Margin="48,0">
                <!-- [Esc] Close (also clickable) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Background="Transparent" Cursor="Hand" MouseLeftButtonUp="CloseHint_Click">
                    <Border Style="{StaticResource KeyHintStyle}">
                        <TextBlock Text="Esc" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Primary}"/>
                    </Border>
                    <TextBlock Text="Close" Style="{StaticResource Text.Body}"/>
                </StackPanel>

                <TextBlock x:Name="HintText" Style="{StaticResource Text.Body}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
