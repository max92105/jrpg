               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:menu="clr-namespace:JRPG.UI.GameMenu"
               Background="Transparent">
    <StackPanel Margin="28,20">
        <TextBlock Text="Options" Style="{StaticResource Text.Heading}"/>

        <Border Style="{StaticResource SectionHeaderStyle}">
            <TextBlock Text="Settings" Style="{StaticResource Text.Label}"/>
        </Border>
        <TextBlock Text="Nothing to set yet." Style="{StaticResource Text.Secondary}" Margin="10,8,0,0"/>
    </StackPanel>
</menu:MenuPage>
