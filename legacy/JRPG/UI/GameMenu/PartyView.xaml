<!--
    Party page:   Active party (n / 4)   |   Reserve
    Click a card to move it to the other side. Drag active members to reorder them.
-->
<menu:MenuPage x:Class="JRPG.UI.GameMenu.PartyView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:menu="clr-namespace:JRPG.UI.GameMenu"
               Background="Transparent">
    <menu:MenuPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JRPG;component/UI/Styles/RoundVerticalScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </menu:MenuPage.Resources>

    <Grid Margin="28,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Active party -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="Active party" Style="{StaticResource Text.Label}"/>
                    <TextBlock x:Name="ActiveCountText" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <StackPanel x:Name="ActivePartyPanel"/>
        </DockPanel>

        <!-- Reserve -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12">
                <TextBlock Text="Reserve" Style="{StaticResource Text.Label}"/>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource RoundVerticalScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="ReservePanel"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</menu:MenuPage>
