<Window x:Class="MapEditor.Controls.MapPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Properties" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Width="280">
        <StackPanel x:Name="NamePanel">
            <TextBlock Text="Name (also the file name when you first save)" Margin="0,0,0,2"/>
            <TextBox x:Name="NameBox"/>
        </StackPanel>
        <TextBlock x:Name="RenameHint" Visibility="Collapsed" TextWrapping="Wrap" Foreground="Gray"
                   Text="The map is named after its file. To rename it, use File > Save As."/>

        <TextBlock Text="Size (tiles)" Margin="0,12,0,2"/>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="WidthBox" Width="60"/>
            <TextBlock Text=" x " VerticalAlignment="Center"/>
            <TextBox x:Name="HeightBox" Width="60"/>
        </StackPanel>
        <CheckBox x:Name="EncountersBox" Content="Random encounters (battles while walking)" Margin="0,14,0,0"
                  ToolTip="Turn off for towns, houses and other safe places"/>

        <TextBlock x:Name="ShrinkWarning" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                   Text="Shrinking hides tiles outside the new size (they stay in the file)."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
