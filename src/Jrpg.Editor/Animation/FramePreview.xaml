<UserControl x:Class="Jrpg.Editor.Animation.FramePreview"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Bound to its FramePlayback; the control's own DataContext stays its host's, which the host's bindings read. -->
  <DockPanel x:Name="Root">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
      <Button Content="|&lt;" Width="32" Command="{Binding StepBackCommand}" ToolTip="Back one frame, paused" />
      <Button Width="56" Margin="4,0" Command="{Binding TogglePlayingCommand}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Play" />
            <Setter Property="ToolTip" Value="Play from the shown frame" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="Content" Value="Pause" />
                <Setter Property="ToolTip" Value="Hold the shown frame" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="&gt;|" Width="32" Command="{Binding StepForwardCommand}" ToolTip="On one frame, paused" />
      <TextBlock Text="{Binding FrameLine}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>

    <!-- Nearest neighbor, so pixel art stays crisp however far the host's area scales it. Centered and clipped, so a
         cover-fit frame larger than the area shows its middle. -->
    <Border x:Name="Picture" Background="Black" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Image x:Name="FrameImage"
             Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Border>
  </DockPanel>
</UserControl>
