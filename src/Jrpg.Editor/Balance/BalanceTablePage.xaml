<UserControl x:Class="Jrpg.Editor.Balance.BalanceTablePage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="BoxLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,6,0" />
    </Style>
    <Style x:Key="Box" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="50" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,1,16,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Numbers right-aligned so the digits line up, as on the Experience page. -->
    <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- A heal's amounts muted: no damage modifier changes them (decisions 786, 994). -->
    <Style x:Key="AmountCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHeal}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
          <Setter Property="ToolTip" Value="Healing: the damage modifier leaves it as it is" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <!-- The boxes and their line on top, the tabs under them; each row list is bound once, since each read rebuilds it. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
      <TextBlock Text="Levels" Style="{StaticResource BoxLabel}" Margin="0,0,6,0"
                 ToolTip="Three levels, each from 1 to the max level: the skill and class columns read one each" />
      <TextBox Text="{Binding FirstLevelText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" />
      <TextBox Text="{Binding SecondLevelText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" />
      <TextBox Text="{Binding ThirdLevelText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" />
      <TextBlock Text="Damage modifier (%)" Style="{StaticResource BoxLabel}"
                 ToolTip="Added to each user's damage modifiers, from -99 to 10000: it raises damage, never healing" />
      <TextBox Text="{Binding ModifierPercentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" />
      <TextBlock Text="Tier Powers" Style="{StaticResource BoxLabel}"
                 ToolTip="Three Powers, each from 0 to 10000: the Tiers tab's columns read one each" />
      <TextBox Text="{Binding FirstPowerText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" />
      <TextBox Text="{Binding SecondPowerText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" />
      <TextBox Text="{Binding ThirdPowerText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding BoxesProblem}" TextWrapping="Wrap" Margin="0,6,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Setter Property="Foreground" Value="{StaticResource ProblemTextBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding BoxesProblem}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <TabControl Margin="0,8,0,0">
      <!-- The class rows, then the enemy rows, their first three columns shared so they line up. -->
      <TabItem Header="Skills">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <StackPanel Margin="8" Grid.IsSharedSizeScope="True">
            <TextBlock Text="Class skills" Style="{StaticResource Section}" Margin="0,0,0,4" />
            <Grid TextBlock.FontWeight="Bold">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Skill" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Tier" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="FirstLevel" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="SecondLevel" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ThirdLevel" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Class" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="1" Text="Skill" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="2" Text="Tier" Style="{StaticResource Cell}"
                         ToolTip="The tier and its per-Power, or the raw power of a skill naming no tier" />
              <TextBlock Grid.Column="3" Text="{Binding FirstLevelText, StringFormat='Level {0}'}"
                         Style="{StaticResource NumberCell}"
                         ToolTip="Each hit before the target, with nothing worn; - before the class learns it" />
              <TextBlock Grid.Column="4" Text="{Binding SecondLevelText, StringFormat='Level {0}'}"
                         Style="{StaticResource NumberCell}"
                         ToolTip="Each hit before the target, with nothing worn; - before the class learns it" />
              <TextBlock Grid.Column="5" Text="{Binding ThirdLevelText, StringFormat='Level {0}'}"
                         Style="{StaticResource NumberCell}"
                         ToolTip="Each hit before the target, with nothing worn; - before the class learns it" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ClassSkillRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Skill" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Tier" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="FirstLevel" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="SecondLevel" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="ThirdLevel" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ClassName}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="1" Text="{Binding SkillName}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="2" Text="{Binding TierLine}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="3" Text="{Binding AmountTexts[0]}" Style="{StaticResource AmountCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding AmountTexts[1]}" Style="{StaticResource AmountCell}" />
                    <TextBlock Grid.Column="5" Text="{Binding AmountTexts[2]}" Style="{StaticResource AmountCell}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Enemy skills" Style="{StaticResource Section}" />
            <Grid TextBlock.FontWeight="Bold">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Skill" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Tier" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyPower" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyAmount" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Enemy" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="1" Text="Skill" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="2" Text="Tier" Style="{StaticResource Cell}"
                         ToolTip="The tier and its per-Power, or the raw power of a skill naming no tier" />
              <TextBlock Grid.Column="3" Text="Power" Style="{StaticResource NumberCell}"
                         ToolTip="The enemy's own Power, what its tiered skills multiply" />
              <TextBlock Grid.Column="4" Text="Amount" Style="{StaticResource NumberCell}"
                         ToolTip="Each hit before the target, at the enemy's Power with the typed modifier" />
            </Grid>
            <ItemsControl ItemsSource="{Binding EnemySkillRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Skill" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Tier" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyPower" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyAmount" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding EnemyName}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="1" Text="{Binding SkillName}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="2" Text="{Binding TierLine}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Power}" Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding AmountText}" Style="{StaticResource AmountCell}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Classes and enemies">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <StackPanel Margin="8" Grid.IsSharedSizeScope="True">
            <TextBlock Text="Classes" Style="{StaticResource Section}" Margin="0,0,0,4" />
            <Grid TextBlock.FontWeight="Bold">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="FirstLevel" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="SecondLevel" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ThirdLevel" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Class" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="1" Text="{Binding FirstLevelText, StringFormat='Level {0}'}"
                         Style="{StaticResource NumberCell}" ToolTip="Max HP / Power, with nothing worn" />
              <TextBlock Grid.Column="2" Text="{Binding SecondLevelText, StringFormat='Level {0}'}"
                         Style="{StaticResource NumberCell}" ToolTip="Max HP / Power, with nothing worn" />
              <TextBlock Grid.Column="3" Text="{Binding ThirdLevelText, StringFormat='Level {0}'}"
                         Style="{StaticResource NumberCell}" ToolTip="Max HP / Power, with nothing worn" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ClassRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="FirstLevel" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="SecondLevel" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="ThirdLevel" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ClassName}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="1" Text="{Binding HpAndPowerTexts[0]}" Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="2" Text="{Binding HpAndPowerTexts[1]}" Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding HpAndPowerTexts[2]}" Style="{StaticResource NumberCell}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Enemies" Style="{StaticResource Section}" />
            <Grid TextBlock.FontWeight="Bold">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyHp" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyPower" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Attack" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="AttackType" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Enemy" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="1" Text="Max HP" Style="{StaticResource NumberCell}" />
              <TextBlock Grid.Column="2" Text="Power" Style="{StaticResource NumberCell}"
                         ToolTip="What its tiered skills multiply" />
              <TextBlock Grid.Column="3" Text="Attack" Style="{StaticResource NumberCell}"
                         ToolTip="Its basic attack's raw damage, which its Power doesn't raise" />
              <TextBlock Grid.Column="4" Text="Attack type" Style="{StaticResource Cell}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding EnemyRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyHp" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="EnemyPower" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Attack" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="AttackType" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding EnemyName}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="1" Text="{Binding MaxHp}" Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="2" Text="{Binding Power}" Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding AttackDamage}" Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding AttackType}" Style="{StaticResource Cell}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- The developer's tier sheet: Power x perPower x (1 + modifiers), one hit (decision 992). -->
      <TabItem Header="Tiers">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <StackPanel Margin="8" Grid.IsSharedSizeScope="True">
            <Grid TextBlock.FontWeight="Bold">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Tier" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Kind" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PerPower" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="FirstPower" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="SecondPower" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ThirdPower" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Tier" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="1" Text="Kind" Style="{StaticResource Cell}" />
              <TextBlock Grid.Column="2" Text="Per Power" Style="{StaticResource NumberCell}" />
              <TextBlock Grid.Column="3" Text="{Binding FirstPowerText, StringFormat='Power {0}'}"
                         Style="{StaticResource NumberCell}" ToolTip="One hit at this Power with the typed modifier" />
              <TextBlock Grid.Column="4" Text="{Binding SecondPowerText, StringFormat='Power {0}'}"
                         Style="{StaticResource NumberCell}" ToolTip="One hit at this Power with the typed modifier" />
              <TextBlock Grid.Column="5" Text="{Binding ThirdPowerText, StringFormat='Power {0}'}"
                         Style="{StaticResource NumberCell}" ToolTip="One hit at this Power with the typed modifier" />
            </Grid>
            <ItemsControl ItemsSource="{Binding TierRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Tier" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Kind" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="PerPower" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="FirstPower" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="SecondPower" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="ThirdPower" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TierId}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="1" Text="{Binding KindLine}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="2" Text="{Binding PerPower}" Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Amounts[0]}" Style="{StaticResource AmountCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding Amounts[1]}" Style="{StaticResource AmountCell}" />
                    <TextBlock Grid.Column="5" Text="{Binding Amounts[2]}" Style="{StaticResource AmountCell}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
