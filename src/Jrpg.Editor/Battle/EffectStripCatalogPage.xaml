<UserControl x:Class="Jrpg.Editor.Battle.EffectStripCatalogPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:battle="clr-namespace:Jrpg.Editor.Battle">
  <DockPanel>
    <!-- The effects images in name order, then the records whose image is missing; an unlisted one is greyed. -->
    <DockPanel DockPanel.Dock="Left" Width="240">
      <TextBlock DockPanel.Dock="Top" Text="Effects images" FontWeight="Bold" />
      <ListBox ItemsSource="{Binding Strips}" SelectedItem="{Binding SelectedStrip}" Margin="0,4,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock x:Name="FileName" Text="{Binding File}" TextTrimming="CharacterEllipsis" />
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsListed}" Value="False">
                <Setter TargetName="FileName" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter TargetName="FileName" Property="ToolTip" Value="Unlisted: no record, so it plays at the default pace, its hit on frame 0" />
              </DataTrigger>
              <DataTrigger Binding="{Binding FrameCount}" Value="{x:Null}">
                <Setter TargetName="FileName" Property="Text" Value="{Binding File, StringFormat={}{0} (image missing)}" />
                <Setter TargetName="FileName" Property="Foreground" Value="{StaticResource ProblemTextBrush}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The chosen strip: its pace, its hit and its swing, as typed; its length line from the image's frames. -->
    <StackPanel Margin="12,0,0,0" DataContext="{Binding SelectedStrip}" Style="{StaticResource EnabledWhenChosen}">
      <TextBlock Text="{Binding File}" FontWeight="Bold" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Frame time (ms)" Width="110" VerticalAlignment="Center" />
        <TextBox Width="70"
                 Text="{Binding FrameMillisecondsText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="How long each frame shows, at least 1 ms" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="Hit frame" Width="110" VerticalAlignment="Center" />
        <TextBox Width="70"
                 Text="{Binding HitFrameText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="The frame, from 0, shown as the blow lands; the frames before it play during the wind-up" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="Swing" Width="110" VerticalAlignment="Center" />
        <ComboBox Width="240"
                  IsEditable="True"
                  ItemsSource="{Binding DataContext.SwingChoices, RelativeSource={RelativeSource AncestorType=battle:EffectStripCatalogPage}}"
                  Text="{Binding SwingFile, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="The strip an Attack sweeps in front of the attacker before this one; empty for none" />
      </StackPanel>
      <TextBlock Text="{Binding LengthText}" Foreground="{StaticResource MutedTextBrush}" Margin="110,8,0,0" />
      <Button Content="Reset to unlisted"
              Width="130"
              HorizontalAlignment="Left"
              Margin="110,12,0,0"
              Command="{Binding DataContext.ResetToUnlistedCommand, RelativeSource={RelativeSource AncestorType=battle:EffectStripCatalogPage}}"
              ToolTip="Back to the default pace, hit frame 0 and no swing: OK then writes no record for it" />

      <!-- The chosen strip looping at its typed frame time, one frame at a time over black, as an enemy's attack shows it
           (a party member's is mirrored in battle); its line says which frame shows and marks the hit. -->
      <Border Width="320" Height="320" HorizontalAlignment="Left" Margin="110,16,0,0" Background="Black" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Image x:Name="StripPreview" Stretch="Uniform" />
      </Border>
      <TextBlock x:Name="FrameText" Foreground="{StaticResource MutedTextBrush}" Margin="110,4,0,0" />
    </StackPanel>
  </DockPanel>
</UserControl>
