<Window x:Class="Jrpg.Editor.Battle.GifImportWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animation="clr-namespace:Jrpg.Editor.Animation"
        Title="Import a GIF"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClicked" IsEnabled="{Binding CanApply}" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>

    <!-- The first chosen GIF as the import composes it. The preview has no pace box of its own: it plays at the
         dialog's pace box, so what plays is what is written. -->
    <animation:FramePreview x:Name="GifPreview"
                            DockPanel.Dock="Right"
                            Width="256"
                            Height="300"
                            Margin="12,0,0,0"
                            FrameMilliseconds="{Binding FrameMilliseconds}" />

    <StackPanel Width="356">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Battle height (px)" Width="130" VerticalAlignment="Center" />
        <TextBox x:Name="HeightBox" Width="70" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" Text="{Binding FactorNote}" />
      <CheckBox Content="Top-left color is background" Margin="0,8,0,0" IsChecked="{Binding RemovesBackground}" />
      <!-- A dock, not a horizontal stack, so a long note wraps beside the box instead of running past the column. -->
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Frame time (ms)" Width="130" VerticalAlignment="Center" />
        <TextBox Width="70"
                 VerticalAlignment="Center"
                 Text="{Binding FrameMillisecondsText, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsPaceTyped}" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding PaceNote}" />
      </DockPanel>
      <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Problem}" />
    </StackPanel>
  </DockPanel>
</Window>
