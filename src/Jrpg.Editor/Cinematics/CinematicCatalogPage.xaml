<UserControl x:Class="Jrpg.Editor.Cinematics.CinematicCatalogPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Jrpg.Editor.Cinematics">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    <local:FocusMarkerMarginConverter x:Key="FocusMarkerMargin" />
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Width" Value="90" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FieldRow" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding MissingNote}"
               ToolTip="Saved as named; the game won't start until the files are there" />

    <!-- The draft's cinematics in id order, the ones added this session after them; only those can be removed. -->
    <DockPanel DockPanel.Dock="Left" Width="200">
      <TextBlock DockPanel.Dock="Top" Text="Cinematics" FontWeight="Bold" />
      <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBox Width="132" Text="{Binding NewId, UpdateSourceTrigger=PropertyChanged}" ToolTip="The new cinematic's id: lowercase letters, digits and _" />
          <Button Content="Add" Width="60" Margin="4,0,0,0" Command="{Binding AddCinematicCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding NewIdProblem}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
        <Button Content="Remove" Width="60" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding RemoveCinematicCommand}" ToolTip="Only a cinematic added this session" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Cinematics}" SelectedItem="{Binding SelectedCinematic}" DisplayMemberPath="Label" Margin="0,4,0,0" />
    </DockPanel>

    <!-- The chosen cinematic: its id and track, its stills in order, the chosen still's boxes and picture. -->
    <DockPanel Margin="12,0,0,0" DataContext="{Binding SelectedCinematic}" Style="{StaticResource EnabledWhenChosen}">
      <StackPanel DockPanel.Dock="Top">
        <StackPanel Style="{StaticResource FieldRow}">
          <TextBlock Text="Id" Style="{StaticResource FieldLabel}" />
          <TextBox Width="240" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}"
                   ToolTip="Fixed once saved, since events name it" />
        </StackPanel>
        <StackPanel Style="{StaticResource FieldRow}">
          <TextBlock Text="Music" Style="{StaticResource FieldLabel}" />
          <ComboBox Width="240"
                    ItemsSource="{Binding DataContext.Choices.Tracks, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}"
                    SelectedItem="{Binding MusicFile}"
                    ToolTip="The track under the whole cinematic; the empty entry keeps the map's" />
        </StackPanel>
      </StackPanel>

      <!-- The stills, numbered as they show, with the picker that adds one after the chosen still. -->
      <DockPanel DockPanel.Dock="Left" Width="330" Margin="0,8,0,0">
        <TextBlock DockPanel.Dock="Top" Text="Stills, in order" FontWeight="Bold" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal">
            <ComboBox Width="230"
                      ItemsSource="{Binding DataContext.Choices.Pictures, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}"
                      SelectedItem="{Binding ImageToAdd}" />
            <Button Content="Add still" Width="80" Margin="4,0,0,0" Command="{Binding AddStillCommand}" ToolTip="After the chosen still" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Remove" Width="60" Command="{Binding RemoveStillCommand}" />
            <Button Content="Up" Width="50" Margin="4,0,0,0" Command="{Binding MoveStillUpCommand}" />
            <Button Content="Down" Width="50" Margin="4,0,0,0" Command="{Binding MoveStillDownCommand}" />
          </StackPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Stills}" SelectedItem="{Binding SelectedStill}" DisplayMemberPath="Label" Margin="0,4,0,0" />
      </DockPanel>

      <!-- The chosen still's boxes, then its picture as the game's screen covers it: centered, the overflow cut. -->
      <!-- Play and Stop sit outside the still's panel, so they work with no still chosen. -->
      <StackPanel Margin="12,8,0,0">
        <StackPanel DataContext="{Binding SelectedStill}" Style="{StaticResource EnabledWhenChosen}">
          <StackPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Picture" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="300" IsEditable="True"
                      ItemsSource="{Binding DataContext.Choices.Pictures, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}"
                      Text="{Binding ImageFile, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Seconds" Style="{StaticResource FieldLabel}" />
            <TextBox Width="60" Text="{Binding SecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="How long the still shows, fades included" />
            <!-- The voice's length, in the warning color when the still ends first (decision 620); the voice runs on. -->
            <TextBlock Text="{Binding VoiceLengthText}" VerticalAlignment="Center" Margin="8,0,0,0"
                       ToolTip="The voice line's length; a voice runs on over the next still until another voice starts">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsShorterThanVoice}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Subtitle" Style="{StaticResource FieldLabel}" />
            <TextBox Width="380" Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" ToolTip="Empty for none" />
          </StackPanel>
          <StackPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Voice" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="300" IsEditable="True"
                      ItemsSource="{Binding DataContext.Choices.Voices, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}"
                      Text="{Binding VoiceFile, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Starts with the still and speaks on until the next voice; empty for none" />
          </StackPanel>
          <StackPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="Zoom from %" Style="{StaticResource FieldLabel}" />
            <TextBox Width="50" Text="{Binding ZoomStartText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="to %" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Width="50" Text="{Binding ZoomEndText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="100 to 150; 100 at both ends is no zoom" />
          </StackPanel>
          <StackPanel Style="{StaticResource FieldRow}">
            <TextBlock Text="{Binding FocusText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button Content="Clear focus" Margin="12,0,0,0" Command="{Binding ClearFocusCommand}" ToolTip="The zoom heads to the center again" />
          </StackPanel>
          <Grid Width="{x:Static local:CinematicCatalogPage.PreviewWidth}" Height="{x:Static local:CinematicCatalogPage.PreviewHeight}" HorizontalAlignment="Left" Margin="0,12,0,0" Background="Black" ClipToBounds="True">
            <!-- The chosen still: a click sets where its zoom heads (decision 753); transparent, so an empty frame takes it. -->
            <Grid Background="Transparent" Cursor="Cross" MouseLeftButtonDown="OnStillPictureClicked" ToolTip="Click to choose where the zoom heads">
              <TextBlock Text="No picture to show" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding ImageFile, Converter={StaticResource PictureOf}}" />
              <!-- The focus: a gold ring and cross over a dark outline, seen on light and dark pictures (decision 755); a
                   click goes through it, so a click on it moves the point. -->
              <Grid Width="{x:Static local:FocusMarkerMarginConverter.MarkerSize}" Height="{x:Static local:FocusMarkerMarginConverter.MarkerSize}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                    Margin="{Binding Focus, Converter={StaticResource FocusMarkerMargin}}"
                    Visibility="{Binding HasFocus, Converter={StaticResource VisibleWhenTrue}}">
                <Ellipse Stroke="{StaticResource WindowBackgroundBrush}" StrokeThickness="3" />
                <Line X1="8" Y1="3" X2="8" Y2="13" Stroke="{StaticResource WindowBackgroundBrush}" StrokeThickness="3" />
                <Line X1="3" Y1="8" X2="13" Y2="8" Stroke="{StaticResource WindowBackgroundBrush}" StrokeThickness="3" />
                <Ellipse Margin="0.5" Stroke="{StaticResource FocusMarkBrush}" StrokeThickness="2" />
                <Line X1="8" Y1="3" X2="8" Y2="13" Stroke="{StaticResource FocusMarkBrush}" StrokeThickness="2" />
                <Line X1="3" Y1="8" X2="13" Y2="8" Stroke="{StaticResource FocusMarkBrush}" StrokeThickness="2" />
              </Grid>
            </Grid>
            <!-- Play's still over black, faded and zoomed about its focus by Core's rules, as the game draws it. The zoom
                 is on this frame-filling grid, not the image, which UniformToFill can make larger than the frame; at
                 100 % or more it still covers the frame, and it takes any click while it shows (decision 753). -->
            <Grid Background="Black"
                  DataContext="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}"
                  Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhenTrue}}"
                  RenderTransformOrigin="{Binding ZoomOrigin}">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
              </Grid.RenderTransform>
              <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="{Binding Opacity}" Source="{Binding ShownImage, Converter={StaticResource PictureOf}}" />
            </Grid>
          </Grid>
        </StackPanel>
        <StackPanel DataContext="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}" Margin="0,4,0,0">
          <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Width="{x:Static local:CinematicCatalogPage.PreviewWidth}" HorizontalAlignment="Left" TextAlignment="Center" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Play" Width="60" Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}"
                    ToolTip="From the chosen still, silent; any box typed stops it" />
            <Button Content="Stop" Width="60" Margin="4,0,0,0" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=local:CinematicCatalogPage}}" />
            <TextBlock Text="{Binding TimeLine}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</UserControl>
