<Window x:Class="Jrpg.Editor.Encounters.MapLinkWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <StackPanel Margin="12">
    <TextBlock Text="Map" />
    <ComboBox x:Name="MapBox" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" DisplayMemberPath="Label" Margin="0,2,0,0"
              ToolTip="The maps whose random battles don't pick this encounter yet" />

    <!-- Only for a map without random battles: linking turns them on, so their odds are asked here. -->
    <StackPanel Visibility="{Binding AsksOdds, Converter={StaticResource VisibleWhenTrue}}" Margin="0,8,0,0">
      <TextBlock Text="This map has no random battles yet; linking turns them on." TextWrapping="Wrap"
                 Foreground="{StaticResource MutedTextBrush}" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="A battle 1 step in" VerticalAlignment="Center" />
        <TextBox Width="60" Margin="6,0,0,0" Text="{Binding OneInStepsText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="none in the first" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBox Width="60" Margin="6,0,0,0" Text="{Binding GraceStepsText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Steps after entering the map or after a fight that can't start a battle" />
        <TextBlock Text="steps" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
      <StackPanel Visibility="{Binding AsksBackground, Converter={StaticResource VisibleWhenTrue}}" Margin="0,6,0,0">
        <TextBlock Text="Battle background" />
        <ComboBox ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding SelectedBackground}" Margin="0,2,0,0"
                  ToolTip="The picture this map's battles are fought on, unless an encounter names its own" />
      </StackPanel>
    </StackPanel>

    <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding Problem}" Margin="0,8,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Link" Width="80" IsDefault="True" Click="OnLinkClicked" IsEnabled="{Binding CanApply}" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
