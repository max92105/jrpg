<Window x:Class="Jrpg.Editor.Events.CellEventWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jrpg.Editor.Events"
        Title="{Binding Title}"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

    <!-- The cell's one event: run when the player walks onto the cell, or arrives on the map. -->
    <DockPanel DataContext="{Binding Event}">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding Id, StringFormat=Event id: {0}}" Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Starts when the player" Width="160" VerticalAlignment="Center" />
          <ComboBox Width="120"
                    ItemsSource="{Binding DataContext.Activations, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding Activation}"
                    ToolTip="Touch: walks onto the cell. Arrive: arrives on the map, such as an intro." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Only while led by" Width="160" VerticalAlignment="Center" />
          <ComboBox Width="160"
                    ItemsSource="{Binding DataContext.LeaderChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding OnlyWhenLeaderId}"
                    ToolTip="Empty: anyone leads" />
        </StackPanel>
        <CheckBox Content="Only once per playthrough (remembered in saves)" IsChecked="{Binding IsOnce}" Margin="0,6,0,8" />
        <TextBlock Text="Steps, run in order" FontWeight="Bold" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
        <TextBlock Text="Add" VerticalAlignment="Center" Margin="0,0,4,0" />
        <Button Content="Warp" Width="60" Command="{Binding AddWarpCommand}" />
        <Button Content="Dialogue" Width="70" Margin="4,0,0,0" Command="{Binding AddDialogueCommand}" />
        <Button Content="Still" Width="50" Margin="4,0,0,0" Command="{Binding AddStillCommand}" />
        <Button Content="Recruit" Width="60" Margin="4,0,0,0" Command="{Binding AddRecruitCommand}" />
        <Button Content="Remove" Width="60" Margin="12,0,0,0" Command="{Binding RemoveStepCommand}" />
        <Button Content="Up" Width="50" Margin="4,0,0,0" Command="{Binding MoveStepUpCommand}" />
        <Button Content="Down" Width="50" Margin="4,0,0,0" Command="{Binding MoveStepDownCommand}" />
      </StackPanel>

      <local:EventStepEditor DockPanel.Dock="Bottom" DataContext="{Binding SelectedStep}" Margin="0,8,0,0" />

      <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" DisplayMemberPath="Label" />
    </DockPanel>
  </DockPanel>
</Window>
