<!-- The fields of one event step, shown for the step in its DataContext; the lists come from the window's Choices. -->
<UserControl x:Class="Jrpg.Editor.Events.EventStepEditor"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </UserControl.Resources>
  <StackPanel>
    <StackPanel Visibility="{Binding IsDialogue, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Lines, one message box each" />
      <TextBox Height="160"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Text="{Binding LinesText, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <TextBlock Text="Speaker (optional)" Width="160" VerticalAlignment="Center" />
        <TextBox Width="160" Text="{Binding Speaker, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <TextBlock Text="Portrait file (optional)" Width="160" VerticalAlignment="Center" />
        <!-- The portraits folder's files, or a typed name: the game's start names a missing one (decision 442). -->
        <ComboBox Width="200"
                  IsEditable="True"
                  ItemsSource="{Binding DataContext.Choices.PortraitFiles, RelativeSource={RelativeSource AncestorType=Window}}"
                  Text="{Binding PortraitFile, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsGiveItem, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Give" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Width="50" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text=" x " VerticalAlignment="Center" />
      <ComboBox Width="200"
                ItemsSource="{Binding DataContext.Choices.ItemIds, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding ItemId}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsOpenShop, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Shop" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="200"
                ItemsSource="{Binding DataContext.Choices.ShopIds, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding ShopId}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCinematic, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Cinematic" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="200"
                ItemsSource="{Binding DataContext.Choices.CinematicIds, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding CinematicId}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsQuestPick, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Quest" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="200"
                ItemsSource="{Binding DataContext.Choices.QuestIds, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding QuestId}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsQuestStagePick, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Quest stage" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="260"
                DisplayMemberPath="Label"
                ItemsSource="{Binding DataContext.Choices.QuestStages, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding QuestStage}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRest, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Price (empty for a free rest)" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Width="80" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecruit, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Joins the party:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox Width="200"
                ItemsSource="{Binding DataContext.Choices.MemberIds, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding MemberId}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSwapObject, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="The object becomes" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox Width="200"
                ItemsSource="{Binding DataContext.Choices.ObjectIds, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding ObjectId}" />
    </StackPanel>
    <StackPanel Visibility="{Binding IsWarp, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Warp to" Width="52" VerticalAlignment="Center" />
        <ComboBox Width="160"
                  ItemsSource="{Binding DataContext.Choices.MapIds, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding MapId}" />
        <TextBlock Text=" at cell (" VerticalAlignment="Center" />
        <TextBox Width="40" Text="{Binding CellXText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text=", " VerticalAlignment="Center" />
        <TextBox Width="40" Text="{Binding CellYText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text=")" VerticalAlignment="Center" />
      </StackPanel>
      <!-- Under the map box, on a line of their own, so the row fits the fields column at the window's smallest. -->
      <StackPanel Orientation="Horizontal" Margin="52,4,0,0">
        <Button Content="Pick..." ToolTip="Choose the map and click the arrival cell on its picture." Click="OnPickWarpDestinationClicked" />
        <Button Content="Go to" Margin="4,0,0,0" ToolTip="Keep these events, then show the destination map on its cell." Click="OnGoToWarpDestinationClicked" />
      </StackPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding IsMoveNpc, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Move NPC" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Width="260"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Uid"
                  ItemsSource="{Binding DataContext.Choices.NpcChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedValue="{Binding MoveNpcUid}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <TextBlock Text="Path" Width="40" VerticalAlignment="Center" />
        <Button Content="Up" Width="50" Command="{Binding AddUpCommand}" />
        <Button Content="Down" Width="50" Margin="4,0,0,0" Command="{Binding AddDownCommand}" />
        <Button Content="Left" Width="50" Margin="4,0,0,0" Command="{Binding AddLeftCommand}" />
        <Button Content="Right" Width="50" Margin="4,0,0,0" Command="{Binding AddRightCommand}" />
        <Button Content="Remove last" Width="90" Margin="12,0,0,0" Command="{Binding RemoveLastMoveStepCommand}" />
      </StackPanel>
      <TextBlock Margin="40,4,0,0" TextWrapping="Wrap" Text="{Binding MovePathText}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsVoice, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
      <TextBlock Text="Voice file (voices folder)" Width="180" VerticalAlignment="Center" />
      <TextBox Width="160" Text="{Binding VoiceFile, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding Problem}" />
  </StackPanel>
</UserControl>
