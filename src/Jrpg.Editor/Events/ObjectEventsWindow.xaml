<Window x:Class="Jrpg.Editor.Events.ObjectEventsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jrpg.Editor.Events"
        Title="{Binding Title}"
        Width="820"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0" />

    <!-- The object's events, in the order they're tried. -->
    <DockPanel DockPanel.Dock="Left" Width="300">
      <TextBlock DockPanel.Dock="Top" Text="Events" FontWeight="Bold" />
      <!-- A preset replaces all the events; the first field it leaves empty is shown. -->
      <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
        <TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,4,0" />
        <Button Content="Chest" Width="50" Command="{Binding ApplyChestPresetCommand}" />
        <Button Content="Door" Width="50" Margin="4,0,0,0" Command="{Binding ApplyDoorPresetCommand}" />
        <Button Content="Door you open" Width="90" Margin="4,0,0,0" Command="{Binding ApplyDoorYouOpenPresetCommand}" />
        <Button Content="Sign" Width="50" Margin="4,0,0,0" Command="{Binding ApplySignPresetCommand}" />
        <Button Content="Talk" Width="50" Margin="4,0,0,0" Command="{Binding ApplyTalkPresetCommand}" />
      </WrapPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Add" Width="60" Command="{Binding AddEventCommand}" />
        <Button Content="Remove" Width="60" Margin="4,0,0,0" Command="{Binding RemoveEventCommand}" />
        <Button Content="Up" Width="50" Margin="4,0,0,0" Command="{Binding MoveEventUpCommand}" />
        <Button Content="Down" Width="50" Margin="4,0,0,0" Command="{Binding MoveEventDownCommand}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" DisplayMemberPath="Label" />
    </DockPanel>

    <!-- The chosen event: when it runs, then its steps. -->
    <DockPanel Margin="12,0,0,0" DataContext="{Binding SelectedEvent}">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding Id, StringFormat=Event id: {0}}" Foreground="Gray" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Starts when the player" Width="160" VerticalAlignment="Center" />
          <ComboBox Width="120"
                    ItemsSource="{Binding DataContext.Activations, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding Activation}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Prompt (for interact)" Width="160" VerticalAlignment="Center" />
          <TextBox Width="160" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Only while the object is" Width="160" VerticalAlignment="Center" />
          <ComboBox Width="160"
                    ItemsSource="{Binding DataContext.OnlyWhenChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding OnlyWhenObjectId}"
                    ToolTip="Empty: always" />
        </StackPanel>
        <CheckBox Content="Only once per playthrough (remembered in saves)" IsChecked="{Binding IsOnce}" Margin="0,6,0,8" />
        <TextBlock Text="Steps, run in order" FontWeight="Bold" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Add" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Content="Dialogue" Width="70" Command="{Binding AddDialogueCommand}" />
          <Button Content="Give item" Width="70" Margin="4,0,0,0" Command="{Binding AddGiveItemCommand}" />
          <Button Content="Swap object" Width="80" Margin="4,0,0,0" Command="{Binding AddSwapObjectCommand}" />
          <Button Content="Warp" Width="60" Margin="4,0,0,0" Command="{Binding AddWarpCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button Content="Remove" Width="60" Command="{Binding RemoveStepCommand}" />
          <Button Content="Up" Width="50" Margin="4,0,0,0" Command="{Binding MoveStepUpCommand}" />
          <Button Content="Down" Width="50" Margin="4,0,0,0" Command="{Binding MoveStepDownCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- The chosen step's fields. -->
      <local:EventStepEditor DockPanel.Dock="Bottom" DataContext="{Binding SelectedStep}" Margin="0,8,0,0" />

      <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" DisplayMemberPath="Label" />
    </DockPanel>
  </DockPanel>
</Window>
