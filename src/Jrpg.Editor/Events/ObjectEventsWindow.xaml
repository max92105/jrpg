<Window x:Class="Jrpg.Editor.Events.ObjectEventsWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jrpg.Editor.Events"
        Title="{Binding Title}"
        Width="1040"
        Height="620"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="12" local:EventStepEditor.PickWarpDestination="OnPickWarpDestination" local:EventStepEditor.GoToWarpDestination="OnGoToWarpDestination">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

    <!-- The object's events, in the order they're tried. -->
    <DockPanel DockPanel.Dock="Left" Width="260">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <!-- A preset replaces all the events; the first field it leaves empty is shown. -->
        <Button x:Name="PresetButton" DockPanel.Dock="Right" Content="Preset ▾" Width="80" Click="OnPresetClicked" ToolTip="Replaces the object's events with a usual set; the first field left to fill is shown. A quest giver's words once its quest is completed are a third event to add.">
          <Button.ContextMenu>
            <ContextMenu ItemsSource="{Binding PresetChoices}" ItemContainerStyle="{StaticResource DropDownEntry}" />
          </Button.ContextMenu>
        </Button>
        <TextBlock Text="Events" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Add" Width="60" Command="{Binding AddEventCommand}" ToolTip="Add an event (Insert in the list)" />
        <Button Content="Remove" Width="60" Margin="4,0,0,0" Command="{Binding RemoveEventCommand}" ToolTip="Remove the chosen event (Delete)" />
        <Button Content="Up" Width="50" Margin="4,0,0,0" Command="{Binding MoveEventUpCommand}" ToolTip="Move the chosen event up (Alt+Up)" />
        <Button Content="Down" Width="50" Margin="4,0,0,0" Command="{Binding MoveEventDownCommand}" ToolTip="Move the chosen event down (Alt+Down)" />
      </StackPanel>
      <ListBox x:Name="EventList" KeyDown="OnEventListKeyDown" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" DisplayMemberPath="Label" />
    </DockPanel>

    <!-- The chosen event: when it runs, then its steps. -->
    <local:EventView Margin="12,0,0,0" DataContext="{Binding SelectedEvent}" />
  </DockPanel>
</Window>
