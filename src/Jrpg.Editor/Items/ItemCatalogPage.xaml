<UserControl x:Class="Jrpg.Editor.Items.ItemCatalogPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalogs="clr-namespace:Jrpg.Editor.Catalogs"
             xmlns:items="clr-namespace:Jrpg.Editor.Items">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Width" Value="90" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ListButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="144" />
      <Setter Property="Margin" Value="0,4,4,0" />
    </Style>
    <!-- A click into a box of a bonus or fixed affix row chooses that row, so the buttons beside the list act on
         the row being typed in. -->
    <Style x:Key="TypedRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="catalogs:RowFocus.ChoosesRow" Value="True" />
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <!-- Every item by category then id, the ones added this session after them; only those can be removed. An item's
         category is its Add button's and never changes after (decision 878). -->
    <DockPanel DockPanel.Dock="Left" Width="300">
      <TextBlock DockPanel.Dock="Top" Text="Items" FontWeight="Bold" />
      <WrapPanel DockPanel.Dock="Bottom">
        <Button Content="Add consumable" Style="{StaticResource ListButton}" Command="{Binding AddItemCommand}"
                CommandParameter="{x:Static items:ItemCategory.Consumable}" ToolTip="A heal used from the menu, last in the list, its id and name to type" />
        <Button Content="Add equipment" Style="{StaticResource ListButton}" Command="{Binding AddItemCommand}"
                CommandParameter="{x:Static items:ItemCategory.Equipment}" ToolTip="A chest armor, last in the list, its id and name to type" />
        <Button Content="Add unique" Style="{StaticResource ListButton}" Command="{Binding AddItemCommand}"
                CommandParameter="{x:Static items:ItemCategory.Unique}" ToolTip="A unique chest armor with no fixed affix yet, last in the list" />
        <Button Content="Add material" Style="{StaticResource ListButton}" Command="{Binding AddItemCommand}"
                CommandParameter="{x:Static items:ItemCategory.Material}" ToolTip="A material the Forge takes, last in the list" />
        <Button Content="Duplicate" Style="{StaticResource ListButton}" Command="{Binding DuplicateCommand}"
                ToolTip="A copy of the chosen item last in the list, its category kept, its id to type" />
        <Button Content="Remove" Style="{StaticResource ListButton}" Command="{Binding RemoveItemCommand}"
                ToolTip="Only an item added this session; shops, drop tables and maps name a saved one" />
      </WrapPanel>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Label" Margin="0,4,0,0" />
    </DockPanel>

    <!-- The chosen item's general fields (decision 879); its category's form comes under them. -->
    <ScrollViewer Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel DataContext="{Binding SelectedItem}" Style="{StaticResource EnabledWhenChosen}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Id" Style="{StaticResource FieldLabel}" />
          <TextBox Width="240"
                   Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsNew}"
                   ToolTip="Lowercase letters, digits and _; fixed once saved, since shops, drop tables and maps name it" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding Category}" ToolTip="Chosen by its Add button; another category is another item" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Width="240" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
          <TextBox Width="400"
                   Height="40"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Shown while choosing the item; it may be empty" />
        </StackPanel>
        <!-- Editable, so a name the folder lacks can still be typed and saved (decision 442); the note says so. -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
          <ComboBox Width="240"
                    VerticalAlignment="Center"
                    IsEditable="True"
                    ItemsSource="{Binding DataContext.IconFiles, RelativeSource={RelativeSource AncestorType=items:ItemCatalogPage}}"
                    Text="{Binding IconFile, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="An image in the icons folder" />
          <Image Width="{x:Static items:ItemCatalogPage.IconPictureSize}"
                 Height="{x:Static items:ItemCatalogPage.IconPictureSize}"
                 Margin="8,0,0,0"
                 Source="{Binding IconFile, Converter={StaticResource PictureOf}}" />
        </StackPanel>
        <TextBlock Margin="90,2,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource ProblemTextBrush}"
                   Text="{Binding DataContext.MissingIconNote, RelativeSource={RelativeSource AncestorType=items:ItemCatalogPage}}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding ShowsMaxStack, Converter={StaticResource VisibleWhenTrue}}">
          <TextBlock Text="Max stack" Style="{StaticResource FieldLabel}" />
          <TextBox Width="60" Text="{Binding MaxStackText, UpdateSourceTrigger=PropertyChanged}" ToolTip="The most copies the inventory holds" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Price" Style="{StaticResource FieldLabel}" />
          <TextBox Width="60" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" ToolTip="The buying price; empty when it is never bought nor sold" />
          <TextBlock Text="{Binding SaleLine}" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Content="Usable from the menu"
                  Margin="90,6,0,0"
                  IsChecked="{Binding IsUsableFromMenu}"
                  Visibility="{Binding ShowsUsableFromMenu, Converter={StaticResource VisibleWhenTrue}}"
                  ToolTip="The menu's Items screen offers it; unticked for a battle-only item" />
        <!-- An equipment's or a unique's form (decision 880); a weapon's damage boxes are hidden off a weapon, which
             writes no damage and no type, as Data requires. -->
        <StackPanel DataContext="{Binding Equipment}" Margin="0,12,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Equipment" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="160"
                      ItemsSource="{Binding KindChoices}"
                      SelectedItem="{Binding Kind}"
                      ToolTip="What it is worn as, which says the slots it fits" />
          </StackPanel>
          <StackPanel Visibility="{Binding IsWeapon, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="Damage" Style="{StaticResource FieldLabel}" />
              <TextBox Width="60"
                       Text="{Binding DamageText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="The wearer's basic attack before Power; at least 1" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="Damage type" Style="{StaticResource FieldLabel}" />
              <ComboBox Width="160"
                        ItemsSource="{Binding DamageTypeChoices}"
                        SelectedItem="{Binding DamageType}"
                        ToolTip="The type its hits meet resistances as" />
            </StackPanel>
          </StackPanel>
          <!-- Each stat once, from those a base item may give: the affix-only stats are rolls' alone (ADR 0030). -->
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Bonuses" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
            <ListBox Width="250" MinHeight="24" ItemsSource="{Binding Bonuses}" SelectedItem="{Binding SelectedBonus}"
                     ItemContainerStyle="{StaticResource TypedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ComboBox Width="170"
                              ItemsSource="{Binding DataContext.StatChoices, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              SelectedItem="{Binding Stat}" />
                    <TextBox Width="50"
                             Margin="4,0,0,0"
                             Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Points for a primary, max HP or speed, percents for the rest; never 0" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="4,0,0,0">
              <Button Content="Add bonus" Width="100" Command="{Binding AddBonusCommand}"
                      ToolTip="The first stat no row names, after the chosen row" />
              <Button Content="Remove bonus" Width="100" Margin="0,4,0,0" Command="{Binding RemoveBonusCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <!-- A unique's fixed affixes (decision 882): any pool affix, whatever kinds it rolls on, its value free of the
             roll range shown beside it (decision 866); the price line adds each affix's gold (decision 871). -->
        <StackPanel Margin="0,12,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Unique}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Fixed affixes" FontWeight="Bold" />
          <StackPanel DataContext="{Binding Unique}" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Affixes" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
            <ListBox Width="340" MinHeight="24" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     ItemContainerStyle="{StaticResource TypedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ComboBox Width="170"
                              ItemsSource="{Binding DataContext.AffixChoices, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              SelectedItem="{Binding Affix}"
                              DisplayMemberPath="Label" />
                    <TextBox Width="50"
                             Margin="4,0,0,0"
                             Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Free of the roll range; Data checks the bound and the affix's side of zero" />
                    <TextBlock Text="{Binding RollLine}" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="4,0,0,0">
              <Button Content="Add affix" Width="100" Command="{Binding AddRowCommand}"
                      ToolTip="The first pool affix no row names, at its roll range's min, after the chosen row" />
              <Button Content="Remove affix" Width="100" Margin="0,4,0,0" Command="{Binding RemoveRowCommand}" />
              <Button Content="Move up" Width="100" Margin="0,4,0,0" Command="{Binding MoveRowUpCommand}" />
              <Button Content="Move down" Width="100" Margin="0,4,0,0" Command="{Binding MoveRowDownCommand}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Margin="90,4,0,0" Text="{Binding PieceValueLine}" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <!-- A consumable's effect (decision 881): a rest's power and the type off a damage are hidden, which writes
             power 0 and no type, as Data requires; its statuses, hits and range are carried, never edited. -->
        <StackPanel Margin="0,12,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Effect}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Effect" FontWeight="Bold" />
          <StackPanel DataContext="{Binding Effect}">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="Effect" Style="{StaticResource FieldLabel}" />
              <ComboBox Width="160"
                        ItemsSource="{Binding KindChoices}"
                        SelectedItem="{Binding Kind}"
                        ToolTip="Hurt, heal, revive, or rest the whole party from the menu" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="Target" Style="{StaticResource FieldLabel}" />
              <ComboBox Width="160"
                        ItemsSource="{Binding TargetingChoices}"
                        SelectedItem="{Binding Targeting}"
                        ToolTip="Whom it may be aimed at; a rest takes all allies" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding TakesPower, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Text="Power" Style="{StaticResource FieldLabel}" />
              <TextBox Width="60"
                       Text="{Binding PowerText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="The HP it deals, heals or revives with, whoever uses it" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding TakesDamageType, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Text="Damage type" Style="{StaticResource FieldLabel}" />
              <ComboBox Width="160"
                        ItemsSource="{Binding DamageTypeChoices}"
                        SelectedItem="{Binding DamageType}"
                        ToolTip="The type its hits meet resistances as" />
            </StackPanel>
          </StackPanel>
          <!-- Editable, so a name the folder lacks can still be typed and saved (decision 442); the note says so. -->
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Own strip" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="240"
                      IsEditable="True"
                      ItemsSource="{Binding DataContext.EffectImages, RelativeSource={RelativeSource AncestorType=items:ItemCatalogPage}}"
                      Text="{Binding EffectFile, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="The strip it plays in battle instead of its user's attack strip; empty plays the user's; a damage's only" />
          </StackPanel>
          <TextBlock Margin="90,2,0,0"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource ProblemTextBrush}"
                     Text="{Binding DataContext.MissingStripNote, RelativeSource={RelativeSource AncestorType=items:ItemCatalogPage}}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
