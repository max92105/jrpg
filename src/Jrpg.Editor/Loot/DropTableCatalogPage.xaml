<UserControl x:Class="Jrpg.Editor.Loot.DropTableCatalogPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loot="clr-namespace:Jrpg.Editor.Loot">
  <UserControl.Resources>
    <!-- The Enemies window keeps its own, 70 wide: two copies, so this one stays local. -->
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="50" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <!-- The draft's tables in id order, the ones added this session after them; only those can be removed. -->
    <DockPanel DockPanel.Dock="Left" Width="200">
      <TextBlock DockPanel.Dock="Top" Text="Drop tables" FontWeight="Bold" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Add table" Width="80" Command="{Binding AddTableCommand}" />
        <Button Content="Remove" Width="60" Margin="4,0,0,0" Command="{Binding RemoveTableCommand}" ToolTip="Only a table added this session" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" DisplayMemberPath="Label" Margin="0,4,0,0" />
    </DockPanel>

    <!-- The chosen table: its id and who rolls it, then its entries in roll order and the picker of items. -->
    <DockPanel Margin="12,0,0,0" DataContext="{Binding SelectedTable}" Style="{StaticResource EnabledWhenChosen}">
      <StackPanel DockPanel.Dock="Top">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Id" Width="60" VerticalAlignment="Center" />
          <TextBox Width="240"
                   Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsNew}"
                   ToolTip="Lowercase letters, digits and _; fixed once saved, since enemies name it" />
        </StackPanel>
        <TextBlock Text="{Binding DataContext.RolledBy, RelativeSource={RelativeSource AncestorType=loot:DropTableCatalogPage}}"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="60,4,0,0"
                   ToolTip="The saved and applied enemies; an open Enemies window's unapplied choices aren't counted" />
        <TextBlock Text="Entries, in roll order" FontWeight="Bold" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="6,4,0,2">
          <TextBlock Text="#" Width="30" />
          <TextBlock Text="Item" Width="220" />
          <TextBlock Text="Chance %" Width="54" ToolTip="Whole percent, 1 to 100, before drop luck" />
          <TextBlock Text="Min" Width="54" />
          <TextBlock Text="Max" Width="54" />
        </StackPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal">
          <ComboBox Width="240"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding DataContext.OfferedItems, RelativeSource={RelativeSource AncestorType=loot:DropTableCatalogPage}}"
                    SelectedItem="{Binding ItemToAdd}" />
          <Button Content="Add entry" Width="80" Margin="4,0,0,0" Command="{Binding AddEntryCommand}" ToolTip="After the chosen entry" />
          <Button Content="Remove" Width="60" Margin="12,0,0,0" Command="{Binding RemoveEntryCommand}" />
          <Button Content="Up" Width="50" Margin="4,0,0,0" Command="{Binding MoveEntryUpCommand}" />
          <Button Content="Down" Width="50" Margin="4,0,0,0" Command="{Binding MoveEntryDownCommand}" />
        </StackPanel>
        <TextBlock Text="Each entry rolls on its own; the chances don't add up." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
      </StackPanel>

      <!-- A click into a row's box chooses that row, so Remove, Up and Down act on the row being typed in. -->
      <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <EventSetter Event="PreviewGotKeyboardFocus" Handler="OnEntryRowFocused" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Index, StringFormat=[{0}]}" Width="30" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ItemLabel}" Width="216" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBox Style="{StaticResource NumberBox}"
                       Text="{Binding ChanceText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Whole percent, 1 to 100, before drop luck" />
              <TextBox Style="{StaticResource NumberBox}" Text="{Binding MinQuantityText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Style="{StaticResource NumberBox}" Text="{Binding MaxQuantityText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
