<Window x:Class="Jrpg.Editor.Maps.MapFolderWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="12">
    <TextBlock Text="Folder" />
    <!-- Typed or picked: a new path makes a new folder; names joined by '/' nest ("Act 1/Village"). -->
    <ComboBox x:Name="PathBox"
              IsEditable="True"
              ItemsSource="{Binding Folders}"
              Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
              Margin="0,2,0,2"
              ToolTip="Pick a folder, or type a new path; names joined by / nest, such as Act 1/Village" />
    <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding Problem}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClicked" IsEnabled="{Binding CanApply}" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
