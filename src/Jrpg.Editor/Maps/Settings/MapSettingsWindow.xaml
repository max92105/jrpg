<Window x:Class="Jrpg.Editor.Maps.Settings.MapSettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <StackPanel Margin="12">
    <TextBlock Text="{Binding MapId, StringFormat=Map id: {0} (fixed; saves and warps refer to it)}" Margin="0,0,0,8" />

    <TextBlock Text="Name shown to the player" />
    <TextBox x:Name="NameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

    <TextBlock Text="Size in cells (width x height)" />
    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
      <TextBox Width="60" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text=" x " VerticalAlignment="Center" />
      <TextBox Width="60" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <TextBlock Foreground="DarkRed" TextWrapping="Wrap" Text="{Binding SizeProblem}" />
    <TextBlock Foreground="DarkOrange"
               TextWrapping="Wrap"
               Text="Shrinking drops the tiles, objects and cell events outside the new size (you're asked first)."
               Visibility="{Binding IsShrinking, Converter={StaticResource VisibleWhenTrue}}" />

    <CheckBox Content="Random battles" IsChecked="{Binding HasRandomEncounters}" Margin="0,8,0,4" />
    <StackPanel IsEnabled="{Binding HasRandomEncounters}" Margin="16,0,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <TextBlock Text="A battle once in about" Width="150" VerticalAlignment="Center" />
        <TextBox Width="50" Text="{Binding OneInStepsText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text=" steps" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <TextBlock Text="No battle for the first" Width="150" VerticalAlignment="Center" />
        <TextBox Width="50" Text="{Binding GraceStepsText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text=" steps" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="Encounters, each as likely" Margin="0,6,0,2" />
      <ListBox ItemsSource="{Binding Encounters}" MaxHeight="160">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding EncounterId}" IsChecked="{Binding IsChosen}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <TextBlock Foreground="DarkRed" TextWrapping="Wrap" Text="{Binding OddsProblem}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
