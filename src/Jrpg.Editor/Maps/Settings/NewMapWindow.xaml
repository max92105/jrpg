<Window x:Class="Jrpg.Editor.Maps.Settings.NewMapWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New map"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="12">
    <TextBlock Text="Name shown to the player" />
    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />
    <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding NameProblem}" />
    <TextBlock Foreground="{StaticResource MutedTextBrush}"
               TextWrapping="Wrap"
               Text="{Binding MapId, StringFormat=Map id: {0} (fixed once created; saves and warps refer to it)}"
               Margin="0,0,0,8" />

    <TextBlock Text="Size in cells (width x height)" />
    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
      <TextBox Width="60" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text=" x " VerticalAlignment="Center" />
      <TextBox Width="60" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding SizeProblem}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Create" Width="80" IsDefault="True" Click="OnCreateClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
