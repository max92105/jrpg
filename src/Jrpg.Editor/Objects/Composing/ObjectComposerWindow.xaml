<Window x:Class="Jrpg.Editor.Objects.Composing.ObjectComposerWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tiles="clr-namespace:Jrpg.Editor.Tiles"
        Title="{Binding Title}"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Painting.UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Painting.RedoCommand}" />
  </Window.InputBindings>
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- The Tiles panel's own sheet view (decision 457): its DataContext is set in code, after its images. -->
    <tiles:TileBrowserView x:Name="Picker" Grid.Column="0" />
    <DockPanel Grid.Column="2">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Id (fixed once created; maps and saves refer to it)" />
        <TextBox x:Name="IdBox" Text="{Binding Naming.Id, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdEditable}" Margin="0,2,0,8" />
        <TextBlock Text="Category (the Objects panel's group)" />
        <ComboBox IsEditable="True"
                  ItemsSource="{Binding Naming.Categories}"
                  Text="{Binding Naming.Category, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,2,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="Columns" VerticalAlignment="Center" />
          <TextBox Width="50" Margin="4,0,12,0" Text="{Binding Painting.ColumnsText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Rows" VerticalAlignment="Center" />
          <TextBox Width="50" Margin="4,0,12,0" Text="{Binding Painting.RowsText, UpdateSourceTrigger=PropertyChanged}" />
          <ToggleButton Content="Erase"
                        Padding="8,2"
                        ToolTip="While on, the left button erases too; the right button always erases."
                        IsChecked="{Binding Painting.IsErasing}" />
          <Button Content="Undo" Padding="8,2" Margin="12,0,0,0" ToolTip="Ctrl+Z: undo the last stroke or size change." Command="{Binding Painting.UndoCommand}" />
          <Button Content="Redo" Padding="8,2" Margin="4,0,0,0" ToolTip="Ctrl+Y" Command="{Binding Painting.RedoCommand}" />
        </StackPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
        <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding Problem}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <!-- Greyed while something stops Save; the line above says what. -->
          <Button Content="Save" Width="80" IsDefault="True" Click="OnSaveClicked">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="True" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
      </StackPanel>
      <TextBlock DockPanel.Dock="Top"
                 Foreground="{StaticResource MutedTextBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,4"
                 Text="Choose a cell or drag a rectangle on the sheet, then click or drag on the canvas to stamp it; right click or drag erases." />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Image x:Name="CanvasImage"
               Focusable="True"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               MouseDown="OnCanvasPressed"
               MouseMove="OnCanvasMouseMoved"
               MouseUp="OnCanvasReleased"
               LostMouseCapture="OnCanvasLostMouseCapture" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
