<Window x:Class="Jrpg.Editor.Objects.NewNpcWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New NPC"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="12">
    <TextBlock Foreground="{StaticResource MutedTextBrush}"
               TextWrapping="Wrap"
               Text="One cell, category NPC, blocking the lower half of its cell; give it a Talk event once placed."
               Margin="0,0,0,8" />

    <TextBlock Text="Id (fixed once created; maps and saves refer to it)" />
    <TextBox x:Name="IdBox" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsIdFixed}" Margin="0,2,0,2" />
    <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding IdProblem}" />

    <TextBlock Text="Sprite (set up in Objects > Character sprites...)" Margin="0,8,0,0" />
    <ComboBox x:Name="SpriteBox" Margin="0,2,0,2" ItemsSource="{Binding SpriteFiles}" SelectedItem="{Binding SpriteFile}" />
    <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Text="{Binding SpriteProblem}" />
    <TextBlock x:Name="PreviewProblem" Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" />

    <!-- The four facings walking over a cell outline, as the map draws them. -->
    <Image x:Name="Preview"
           Stretch="None"
           HorizontalAlignment="Left"
           Margin="0,8,0,0"
           RenderOptions.BitmapScalingMode="NearestNeighbor" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="Create" Width="80" IsDefault="True" Click="OnOkClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
