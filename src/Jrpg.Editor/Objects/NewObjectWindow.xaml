<Window x:Class="Jrpg.Editor.Objects.NewObjectWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New object from selection"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="12">
    <TextBlock Foreground="Gray" Text="{Binding SizeText, StringFormat=Made from {0} of the sheet; its shapes are drawn next.}" Margin="0,0,0,8" />

    <TextBlock Text="Id (fixed once created; maps and saves refer to it)" />
    <TextBox x:Name="IdBox" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />
    <TextBlock Foreground="DarkRed" TextWrapping="Wrap" Text="{Binding IdProblem}" />

    <TextBlock Text="Category (the Objects panel's group)" Margin="0,8,0,0" />
    <ComboBox IsEditable="True"
              ItemsSource="{Binding Categories}"
              Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
              Margin="0,2,0,2" />
    <TextBlock Foreground="DarkRed" TextWrapping="Wrap" Text="{Binding CategoryProblem}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Create" Width="80" IsDefault="True" Click="OnCreateClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
