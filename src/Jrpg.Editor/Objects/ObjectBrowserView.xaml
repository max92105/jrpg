<UserControl x:Class="Jrpg.Editor.Objects.ObjectBrowserView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <CollectionViewSource x:Key="ObjectsByCategory" Source="{Binding Objects}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Category" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Height="220" Background="{StaticResource ViewportBackgroundBrush}">
      <Image x:Name="Preview"
             Stretch="Uniform"
             StretchDirection="DownOnly"
             RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Border>
    <!-- Removal is refused while a map places the object or an event swaps to it (decision 443); the line says which. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,4">
      <Button HorizontalAlignment="Left"
              Padding="8,2"
              Content="Remove"
              ToolTip="Take the chosen object out of the catalog; refused while a map uses it. Ctrl+Z puts it back."
              Command="{Binding RemoveSelectedCommand}" />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding RemovalStatus}" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Source={StaticResource ObjectsByCategory}}"
             SelectedItem="{Binding SelectedObject}"
             DisplayMemberPath="Id">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding Name}" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
    </ListBox>
  </DockPanel>
</UserControl>
