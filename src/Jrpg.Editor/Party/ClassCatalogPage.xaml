<UserControl x:Class="Jrpg.Editor.Party.ClassCatalogPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalogs="clr-namespace:Jrpg.Editor.Catalogs"
             xmlns:party="clr-namespace:Jrpg.Editor.Party">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Width" Value="90" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="60" />
      <Setter Property="Margin" Value="0,2,12,2" />
    </Style>
    <!-- The Levels tab's header and numbers, right-aligned so the digits line up. -->
    <Style x:Key="LevelCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,1,12,1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- A click into a skill row's Level box chooses that row, so Remove and the moves act on the row being typed in. -->
    <Style x:Key="TypedRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="catalogs:RowFocus.ChoosesRow" Value="True" />
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <!-- The draft's classes in id order, the ones added this session after them; only those can be removed (decision 945). -->
    <DockPanel DockPanel.Dock="Left" Width="240">
      <TextBlock DockPanel.Dock="Top" Text="Classes" FontWeight="Bold" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Add" Width="50" Command="{Binding AddClassCommand}" ToolTip="A new class last in the list, its id to type" />
        <Button Content="Duplicate" Width="70" Margin="4,0,0,0" Command="{Binding DuplicateClassCommand}"
                ToolTip="A copy of the chosen class after it, skills and resources included; type its id" />
        <Button Content="Remove" Width="60" Margin="4,0,0,0" Command="{Binding RemoveClassCommand}"
                ToolTip="Only a class added this session; party members may name a saved one" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" DisplayMemberPath="Label" Margin="0,4,0,0" />
    </DockPanel>

    <!-- The chosen class in tabs; Stats holds its texts, then its base and growth side by side, a row per stat. -->
    <DockPanel Margin="12,0,0,0" DataContext="{Binding SelectedClass}" Style="{StaticResource EnabledWhenChosen}">
      <TabControl>
        <TabItem Header="Stats">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Id" Style="{StaticResource FieldLabel}" />
                <TextBox Width="240"
                         Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNew}"
                         ToolTip="Lowercase letters, digits and _; fixed once saved, since party members name it" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                <TextBox Width="240" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                <TextBox Width="400"
                         MinLines="3"
                         MaxLines="3"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Shown on the leader screen beside the class's name" />
              </StackPanel>

              <!-- The primaries follow max HP, speed and accuracy in StatKinds' order, as every screen lists them. -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Text="Base" FontWeight="Bold" ToolTip="The stats at level 1" />
                <TextBlock Grid.Column="2" Text="Growth (per level)" FontWeight="Bold" ToolTip="What each level after the first adds" />

                <TextBlock Grid.Row="1" Text="Max HP" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.MaxHpText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.MaxHpText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Text="Speed" Style="{StaticResource FieldLabel}"
                           ToolTip="Sets the rogue's readiness charges; turn order ignores speed for now." />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.SpeedText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.SpeedText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Text="Accuracy" Style="{StaticResource FieldLabel}" ToolTip="Points added to the rules' base accuracy" />
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.AccuracyText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.AccuracyText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Text="Power" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.PowerText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="4" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.PowerText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Text="Agility" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.AgilityText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="5" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.AgilityText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="6" Text="Intelligence" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.IntelligenceText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="6" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.IntelligenceText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="7" Text="Constitution" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.ConstitutionText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="7" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.ConstitutionText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="8" Text="Will" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Base.WillText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="8" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Growth.WillText, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Read-only: each level as a member of the class wearing nothing has it, from the boxes as typed (decision 948). -->
        <TabItem Header="Levels">
          <DockPanel Margin="8" Grid.IsSharedSizeScope="True">
            <TextBlock DockPanel.Dock="Top" Text="{Binding LevelsProblem}" TextWrapping="Wrap" Margin="0,0,0,6">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource ProblemTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LevelsProblem}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Grid DockPanel.Dock="Top" TextBlock.FontWeight="Bold">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Level" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ToNext" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MaxHp" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Speed" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Accuracy" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Power" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Agility" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Intelligence" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Constitution" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Will" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Level" Style="{StaticResource LevelCell}" />
              <TextBlock Grid.Column="1" Text="To next" Style="{StaticResource LevelCell}"
                         ToolTip="The experience from this level to the next; none at the table's last level" />
              <TextBlock Grid.Column="2" Text="Max HP" Style="{StaticResource LevelCell}"
                         ToolTip="Constitution's share included, with nothing worn" />
              <TextBlock Grid.Column="3" Text="Speed" Style="{StaticResource LevelCell}" />
              <TextBlock Grid.Column="4" Text="Accuracy %" Style="{StaticResource LevelCell}" />
              <TextBlock Grid.Column="5" Text="Power" Style="{StaticResource LevelCell}" />
              <TextBlock Grid.Column="6" Text="Agility" Style="{StaticResource LevelCell}" />
              <TextBlock Grid.Column="7" Text="Intelligence" Style="{StaticResource LevelCell}" />
              <TextBlock Grid.Column="8" Text="Constitution" Style="{StaticResource LevelCell}" />
              <TextBlock Grid.Column="9" Text="Will" Style="{StaticResource LevelCell}" />
            </Grid>
            <!-- Virtualized: a long table builds only the rows in view. -->
            <ItemsControl ItemsSource="{Binding LevelRows}"
                          Margin="0,4,0,0"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Level" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="ToNext" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="MaxHp" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Speed" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Accuracy" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Power" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Agility" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Intelligence" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Constitution" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Will" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Level}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="1" Text="{Binding ExperienceToNext}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="2" Text="{Binding MaxHp}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Speed}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding AccuracyPercent}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="5" Text="{Binding Primaries.Power}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="6" Text="{Binding Primaries.Agility}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="7" Text="{Binding Primaries.Intelligence}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="8" Text="{Binding Primaries.Constitution}" Style="{StaticResource LevelCell}" />
                    <TextBlock Grid.Column="9" Text="{Binding Primaries.Will}" Style="{StaticResource LevelCell}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </TabItem>

        <!-- The skills in the order the battle's Skills menu lists them (ADR 0020), each with its level (ADR 0062). -->
        <TabItem Header="Skills">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" TextBlock.FontWeight="Bold">
              <TextBlock Text="Skill" Width="260" />
              <TextBlock Text="Level" ToolTip="The level a member learns it at; 1: from the start." />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
              <ComboBox Width="260" ItemsSource="{Binding SkillsToAdd}" SelectedItem="{Binding SkillToAdd}" DisplayMemberPath="Label"
                        ToolTip="Every skill of the content not listed yet; the line names one using a resource the class lacks" />
              <Button Content="Add" Width="60" Margin="4,0,0,0" Command="{Binding AddSkillCommand}"
                      ToolTip="After the chosen skill, learned from level 1" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
              <Button Content="Up" Width="60" Command="{Binding MoveSkillUpCommand}" />
              <Button Content="Down" Width="60" Margin="0,4,0,0" Command="{Binding MoveSkillDownCommand}" />
              <Button Content="Remove" Width="60" Margin="0,4,0,0" Command="{Binding RemoveSkillCommand}" />
            </StackPanel>
            <ListBox Margin="0,4,0,0" ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}"
                     ItemContainerStyle="{StaticResource TypedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Width="256" Text="{Binding Skill.Label}" VerticalAlignment="Center" />
                    <TextBox Width="40" Text="{Binding LevelText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <TabItem Header="Resources">
          <party:ClassResourcesView />
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</UserControl>
