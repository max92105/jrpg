<MenuItem x:Class="Jrpg.Editor.Shell.DatabaseMenu"
          x:ClassModifier="internal"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          Style="{StaticResource {x:Type MenuItem}}"
          Header="Database">
  <!-- Its own file so each Database editor adds its entry here, not to the main window (decision 938). An entry's Tag is
       the title the main window opens it by; the theme's style is set above, since an implicit style skips a subclass. -->
  <MenuItem Header="Quests..." Tag="Quests" />
  <MenuItem Header="Shops..." Tag="Shops" ToolTip="Each shop's name and the priced items it sells, in order; the shopkeeper preset's shop box offers them." />
  <MenuItem Header="Drop tables..." Tag="Drop tables" ToolTip="Each table's items, chances and quantities; the Enemies page's Drop table box offers them." />
  <MenuItem Header="Effect strips..." Tag="Effect strips" ToolTip="Each effects image's frame time, the frame its hit lands on and the swing an Attack plays first." />
  <MenuItem Header="Skills..." Tag="Skills" ToolTip="Each skill's name, texts, icon, sound, own strip, costs, effect and statuses; classes and enemies still list theirs in their files." />
  <MenuItem Header="Cinematics..." Tag="Cinematics" ToolTip="Each cinematic's stills in order, their seconds, subtitles, voices and zoom, and its music." />
  <MenuItem Header="Enemies..." Tag="Enemies" ToolTip="Each enemy's numbers, resistances, rewards and pictures; tactics and phases stay in enemies.json, encounters in encounters.json." />
</MenuItem>
