<!-- The entries of a button's drop-down menu (the event dialog's Add step), over the theme's menu entry. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- CommandParameter is set before Command, so the command's first CanExecute already sees its parameter. The header
       is drawn by a template as plain text: the theme's menu entry reads a string header's "_" as an access key and
       would hide it in an id such as placeholder_errand. A title is disabled: greyed, and skipped by the arrow keys. -->
  <Style x:Key="DropDownEntry" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="CommandParameter" Value="{Binding Parameter}" />
    <Setter Property="Command" Value="{Binding Command}" />
    <Setter Property="Header" Value="{Binding Label}" />
    <Setter Property="HeaderTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsTitle}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,0" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
