<!-- The editor's dark theme (decision 121, after the legacy MapEditor). Every look value of a view lives here, named by
     role; drawing colors (map marks, overlay, handles) stay named constants in their drawing classes. The controls
     whose Windows templates hard-code light colors get dark templates in EditorTemplates.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111111" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#181818" />
  <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="#202020" />
  <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
  <SolidColorBrush x:Key="TextBrush" Color="#DDDDDD" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#999999" />
  <SolidColorBrush x:Key="StatusTextBrush" Color="#88CC88" />
  <SolidColorBrush x:Key="ProblemTextBrush" Color="#FF6B6B" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#E0A040" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2C2C2C" />
  <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#2A4D6E" />

  <!-- WPF's default templates read these system colors for menus, lists and drop-downs, so they turn dark too. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#181818" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#DDDDDD" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#181818" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#DDDDDD" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#181818" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#DDDDDD" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A4D6E" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#26364A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#DDDDDD" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#777777" />

  <!-- WPF doesn't apply implicit styles to Window subclasses, so every window sets this one. -->
  <Style x:Key="EditorWindow" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="PanelControl" TargetType="Control">
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
  </Style>
  <Style TargetType="Menu" BasedOn="{StaticResource PanelControl}" />
  <Style TargetType="ToolBarTray">
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
  </Style>
  <Style TargetType="TabControl" BasedOn="{StaticResource PanelControl}" />
  <Style TargetType="ListBox" BasedOn="{StaticResource PanelControl}" />
  <Style TargetType="Expander" BasedOn="{StaticResource PanelControl}" />
  <Style TargetType="StatusBar" BasedOn="{StaticResource PanelControl}">
    <Setter Property="Background" Value="{StaticResource ViewportBackgroundBrush}" />
  </Style>
  <Style TargetType="StatusBarItem">
    <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}" />
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource PanelControl}">
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
  </Style>

  <!-- The default button turns light blue on hover, under light text; this one stays dark in every state. -->
  <Style x:Key="EditorButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{StaticResource PressedBackgroundBrush}" />
            </Trigger>
            <!-- OK and Create (the default button) stand out from Cancel, as in the Windows look. -->
            <Trigger Property="IsDefaulted" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource SelectionBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource SelectionBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource EditorButton}" />
  <!-- Tool bars give their buttons a style of their own, so it is replaced too. -->
  <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource EditorButton}">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The default selected tab is white; this one is the panel's color, joined to the page below it. -->
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab"
                  Margin="0,0,2,0"
                  Padding="10,4"
                  Background="{StaticResource WindowBackgroundBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1,1,1,0">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
