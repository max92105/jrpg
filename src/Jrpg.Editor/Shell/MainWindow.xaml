<Window x:Class="Jrpg.Editor.Shell.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tiles="clr-namespace:Jrpg.Editor.Tiles"
        xmlns:objects="clr-namespace:Jrpg.Editor.Objects"
        Title="Jrpg map editor"
        WindowState="Maximized">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding CurrentMap.UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding CurrentMap.RedoCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
  </Window.InputBindings>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top"
               Margin="8"
               Foreground="DarkRed"
               TextWrapping="Wrap"
               Text="{Binding LoadError}" />
    <TextBlock DockPanel.Dock="Top"
               Margin="8,0"
               Foreground="DarkRed"
               TextWrapping="Wrap"
               Text="{Binding SaveError, StringFormat=Not saved: {0}, TargetNullValue=''}" />
    <ToolBar DockPanel.Dock="Top">
      <Button Content="New map..." Click="OnNewMapClicked" />
      <Button Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" />
      <Button Content="Undo (Ctrl+Z)" Command="{Binding CurrentMap.UndoCommand}" />
      <Button Content="Redo (Ctrl+Y)" Command="{Binding CurrentMap.RedoCommand}" />
      <Button Content="Map settings..." Click="OnMapSettingsClicked" />
      <Separator />
      <CheckBox Content="Grid" IsChecked="{Binding IsGridShown}" />
      <Separator />
      <TextBlock Text="Layer" VerticalAlignment="Center" Margin="4,0" />
      <ComboBox Width="230"
                ItemsSource="{Binding Layer.Presets}"
                SelectedValuePath="Z"
                SelectedValue="{Binding Layer.Z}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /> (<Run Text="{Binding Z, Mode=OneWay}" />)</TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox Width="40"
               ToolTip="Layer z: any whole number"
               Text="{Binding Layer.Z, UpdateSourceTrigger=PropertyChanged}" />
      <CheckBox Content="Dim other layers" IsChecked="{Binding Layer.AreOtherLayersDimmed}" />
      <Separator />
      <TextBlock Text="Tool (B R F)" VerticalAlignment="Center" Margin="4,0" />
      <ComboBox Width="90"
                ToolTip="Brush: drag. Rectangle: drag, filled on release. Fill: click (or Shift + click with any tool). Right button erases."
                ItemsSource="{Binding Painting.Tools}"
                SelectedItem="{Binding Painting.Tool}" />
      <TextBlock Text="Brush ([ ])" VerticalAlignment="Center" Margin="4,0" />
      <ComboBox Width="50" ItemsSource="{Binding Painting.BrushSizes}" SelectedItem="{Binding Painting.BrushSize}" />
      <Button Content="Fill layer" Command="{Binding Painting.FillLayerCommand}" />
      <Button Content="Clear layer" Command="{Binding Painting.ClearLayerCommand}" />
      <Separator />
      <Button Content="Fit (Ctrl+0)" Click="OnFitClicked" />
      <Button Content="100 % (Ctrl+1)" Click="OnActualSizeClicked" />
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding CursorStatus}" />
      <StatusBarItem Content="Unsaved changes"
                     Visibility="{Binding CurrentMap.IsDirty, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
      <StatusBarItem x:Name="ZoomStatus" HorizontalAlignment="Right" />
    </StatusBar>
    <ListBox x:Name="MapList"
             DockPanel.Dock="Left"
             Width="180"
             ItemsSource="{Binding MapIds}"
             SelectionChanged="OnMapListSelectionChanged" />
    <DockPanel DockPanel.Dock="Right" Width="420">
      <ListBox DockPanel.Dock="Top"
               Height="110"
               ItemsSource="{Binding CurrentMap.Layers}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Z, StringFormat=Layer z {0}}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TabControl x:Name="EditingTabs" SelectionChanged="OnEditingTabChanged">
        <TabItem Header="Tiles">
          <tiles:TileBrowserView x:Name="TileBrowser" DataContext="{Binding Painting.Browser}" />
        </TabItem>
        <!-- Click places the chosen object, Shift + drag moves one, right click or Delete removes, Ctrl + drag selects. -->
        <TabItem x:Name="ObjectsTab" Header="Objects">
          <objects:ObjectBrowserView x:Name="ObjectBrowser" DataContext="{Binding Placing.Browser}" />
        </TabItem>
        <TabItem x:Name="EventsTab" Header="Events">
          <TextBlock Margin="8"
                     TextWrapping="Wrap"
                     Text="Click an object on the map to edit its events. Dots on an object show its events: yellow when the player presses a button, cyan when the player walks into it." />
        </TabItem>
      </TabControl>
    </DockPanel>
    <!-- Pan: middle drag, Space + drag, arrows. Zoom: wheel, toward the cursor. Left drag paints the chosen tile,
         right drag erases, Alt + click picks the tile and layer under the mouse. -->
    <Border x:Name="MapViewport"
            Background="#202020"
            ClipToBounds="True"
            Focusable="True"
            PreviewMouseDown="OnViewportMouseDown"
            PreviewMouseMove="OnViewportMouseMove"
            PreviewMouseUp="OnViewportMouseUp"
            MouseWheel="OnViewportMouseWheel"
            MouseLeave="OnViewportMouseLeave"
            LostMouseCapture="OnViewportLostMouseCapture"
            SizeChanged="OnViewportSizeChanged">
      <!-- A canvas gives the map its full size, so the view's bounds clip it rather than layout. -->
      <Canvas>
        <!-- Nearest-pixel scaling and aliased edges keep pixel art sharp and tiles seamless, as in the game. -->
        <Grid x:Name="MapLayers"
              RenderOptions.BitmapScalingMode="NearestNeighbor"
              RenderOptions.EdgeMode="Aliased">
          <Image x:Name="MapImage" Stretch="None" />
          <Image x:Name="GridImage"
                 Stretch="None"
                 Visibility="{Binding IsGridShown, Converter={StaticResource VisibleWhenTrue}}" />
          <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="BrushOutline" Stroke="White" Visibility="Collapsed" />
            <Image x:Name="ObjectGhost" Stretch="None" Opacity="0.6" Visibility="Collapsed" />
            <Canvas x:Name="SelectionMarks" />
            <Canvas x:Name="EventMarks" />
            <Rectangle x:Name="SelectionOutline" Stroke="Cyan" StrokeDashArray="4 2" Visibility="Collapsed" />
          </Canvas>
        </Grid>
      </Canvas>
    </Border>
  </DockPanel>
</Window>
