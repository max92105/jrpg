<Window x:Class="Jrpg.Editor.Shell.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jrpg map editor"
        Width="1280"
        Height="800">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top"
               Margin="8"
               Foreground="DarkRed"
               TextWrapping="Wrap"
               Text="{Binding LoadError}" />
    <ListBox DockPanel.Dock="Left"
             Width="180"
             ItemsSource="{Binding MapIds}"
             SelectedItem="{Binding SelectedMapId}" />
    <ListBox DockPanel.Dock="Right"
             Width="140"
             ItemsSource="{Binding CurrentMap.Layers}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Z, StringFormat=Layer z {0}}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer Background="#202020"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <!-- Nearest-pixel scaling and aliased edges keep pixel art sharp and tiles seamless, as in the game. -->
      <Image x:Name="MapImage"
             Stretch="None"
             RenderOptions.BitmapScalingMode="NearestNeighbor"
             RenderOptions.EdgeMode="Aliased"
             SnapsToDevicePixels="True" />
    </ScrollViewer>
  </DockPanel>
</Window>
