<UserControl x:Class="Jrpg.Editor.Shell.MapListPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBox x:Name="MapFilterBox"
             DockPanel.Dock="Top"
             Text="{Binding Navigation.Filter, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Type part of a map's name or id; Enter opens the first one, Esc clears (Ctrl+M)"
             PreviewKeyDown="OnMapFilterKeyDown" />
    <ListBox x:Name="MapList"
             ItemsSource="{Binding Navigation.ShownEntries, NotifyOnTargetUpdated=True}"
             TargetUpdated="OnMapListUpdated"
             DisplayMemberPath="Text"
             SelectedValuePath="Id"
             SelectionChanged="OnMapListSelectionChanged">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Rename map..."
                    Click="OnRenameMapClicked"
                    IsEnabled="{Binding CanRenameMap}"
                    ToolTip="{Binding RenameMapTip}"
                    ToolTipService.ShowOnDisabled="True" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
  </DockPanel>
</UserControl>
