<UserControl x:Class="Jrpg.Editor.Skills.SkillCatalogPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skills="clr-namespace:Jrpg.Editor.Skills">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Width" Value="90" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A click into a cost or grant row's box chooses that row, so Add, Remove and the moves act on the row being typed
         in. -->
    <Style x:Key="TypedRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <EventSetter Event="PreviewGotKeyboardFocus" Handler="OnTypedRowFocused" />
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <!-- The draft's skills in id order, the ones added this session after them; only those can be removed. -->
    <DockPanel DockPanel.Dock="Left" Width="220">
      <TextBlock DockPanel.Dock="Top" Text="Skills" FontWeight="Bold" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Add" Width="50" Command="{Binding AddSkillCommand}" ToolTip="A damage skill on the first damage tier, last in the list" />
        <Button Content="Duplicate" Width="70" Margin="4,0,0,0" Command="{Binding DuplicateSkillCommand}" ToolTip="A copy of the chosen skill after it, its id to type" />
        <Button Content="Remove" Width="60" Margin="4,0,0,0" Command="{Binding RemoveSkillCommand}" ToolTip="Only a skill added this session; classes and enemies name a saved one" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}" Margin="0,4,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Id}" />
              <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The chosen skill: its texts, files, costs, effect and the statuses it grants. Who uses it is read-only: the
         classes and enemies files name it. -->
    <ScrollViewer Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel DataContext="{Binding SelectedSkill}" Style="{StaticResource EnabledWhenChosen}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Id" Style="{StaticResource FieldLabel}" />
          <TextBox Width="240"
                   Text="{Binding IdText, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsNew}"
                   ToolTip="Lowercase letters, digits and _; fixed once saved, since classes and enemies name it" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Width="240" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
          <TextBox Width="400"
                   Height="40"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Shown while choosing the skill; it may be empty" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
          <ComboBox Width="240"
                    ItemsSource="{Binding DataContext.Choices.Icons, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                    SelectedItem="{Binding IconFile}"
                    ToolTip="An image in the icons folder; the empty entry for none" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Sound" Style="{StaticResource FieldLabel}" />
          <ComboBox Width="240"
                    ItemsSource="{Binding DataContext.Choices.Sounds, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                    SelectedItem="{Binding SoundFile}"
                    ToolTip="A sound in the audio effects folder, played as its action starts; empty only until a new skill gets one" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Strip" Style="{StaticResource FieldLabel}" />
          <ComboBox Width="240"
                    ItemsSource="{Binding DataContext.Choices.EffectImages, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                    SelectedItem="{Binding EffectFile}"
                    ToolTip="The effects strip its action plays instead of the actor's attack strip">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock x:Name="File" Text="{Binding}" />
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding}" Value="">
                    <Setter TargetName="File" Property="Text" Value="(the actor's attack strip)" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBlock Text="{Binding DataContext.StripPaceText, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="90,2,0,0" />
        <CheckBox Content="Quick" Margin="90,6,0,0" IsChecked="{Binding IsQuick}" ToolTip="Keeps the turn; needs a cost" />

        <!-- Costs as Core holds them: changes (negative spends, positive gains), then needs, never spent. -->
        <StackPanel DataContext="{Binding Costs}">
          <TextBlock Text="Costs" FontWeight="Bold" Margin="0,12,0,0" />
          <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Changes" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
            <ListBox Width="320" MinHeight="24" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}"
                     ItemContainerStyle="{StaticResource TypedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ComboBox Width="220"
                              ItemsSource="{Binding DataContext.Choices.Resources, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ResourceId}" />
                    <TextBox Width="60"
                             Margin="4,0,0,0"
                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Negative spends, positive gains" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="4,0,0,0">
              <Button Content="Add" Width="60" Command="{Binding AddChangeCommand}" ToolTip="A change spending 1 of the first resource, after the chosen row" />
              <Button Content="Remove" Width="60" Margin="0,4,0,0" Command="{Binding RemoveChangeCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Needs" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
            <ListBox Width="320" MinHeight="24" ItemsSource="{Binding Needs}" SelectedItem="{Binding SelectedNeed}"
                     ItemContainerStyle="{StaticResource TypedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ComboBox Width="220"
                              ItemsSource="{Binding DataContext.Choices.Resources, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ResourceId}" />
                    <TextBox Width="60"
                             Margin="4,0,0,0"
                             Text="{Binding AtLeastText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The least its user must hold; never spent" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="4,0,0,0">
              <Button Content="Add" Width="60" Command="{Binding AddNeedCommand}" ToolTip="A need of 1 of the first resource, after the chosen row" />
              <Button Content="Remove" Width="60" Margin="0,4,0,0" Command="{Binding RemoveNeedCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- A tier sets the kind, the type and the amount; a box the tier, the kind or the targeting doesn't read greys. -->
        <StackPanel DataContext="{Binding Effect}">
          <TextBlock Text="Effect" FontWeight="Bold" Margin="0,12,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Tier" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="240"
                      ItemsSource="{Binding DataContext.Choices.Tiers, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                      DisplayMemberPath="Line"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding TierId}"
                      ToolTip="A named damage or heal: the user's Power times its per-Power number (Database > Effects...)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="160" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" IsEnabled="{Binding CanTypeKind}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Damage type" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="160"
                      ItemsSource="{Binding DamageTypes}"
                      SelectedItem="{Binding DamageType}"
                      IsEnabled="{Binding CanTypeDamageType}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Power" Style="{StaticResource FieldLabel}" />
            <TextBox Width="60"
                     Text="{Binding PowerText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanTypePower}"
                     ToolTip="Used without a tier: HP before the user's Power raises it" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Targeting" Style="{StaticResource FieldLabel}" />
            <ComboBox Width="160" ItemsSource="{Binding Targetings}" SelectedItem="{Binding Targeting}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Range" Style="{StaticResource FieldLabel}" />
            <TextBox Width="60"
                     Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanTypeRange}"
                     ToolTip="How many places on each side an alliesInRange effect reaches" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Hits" Style="{StaticResource FieldLabel}" />
            <TextBox Width="60"
                     Text="{Binding HitsText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Times it lands on each target; above 1 only for damage" />
          </StackPanel>
        </StackPanel>
        <!-- The statuses the effect grants, in the order they land: each with its turns and its chance before resistance. -->
        <StackPanel DataContext="{Binding Grants}">
          <TextBlock Text="Statuses" FontWeight="Bold" Margin="0,12,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ListBox Width="410" MinHeight="24" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     ItemContainerStyle="{StaticResource TypedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ComboBox Width="220"
                              ItemsSource="{Binding DataContext.Choices.Statuses, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                              DisplayMemberPath="Line"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding StatusId}" />
                    <TextBox Width="40"
                             Margin="4,0,0,0"
                             Text="{Binding TurnsText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="How many of the holder's turns it lasts, at least 1" />
                    <TextBlock Text="turns" Margin="4,0,0,0" VerticalAlignment="Center" />
                    <TextBox Width="40"
                             Margin="8,0,0,0"
                             Text="{Binding ChanceText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The percent it lands with before Intelligence and resistance, 1 to 100" />
                    <TextBlock Text="%" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="4,0,0,0">
              <Button Content="Add" Width="60" Command="{Binding AddRowCommand}" ToolTip="The first status for 1 turn at 100 %, after the chosen row" />
              <Button Content="Remove" Width="60" Margin="0,4,0,0" Command="{Binding RemoveRowCommand}" />
              <Button Content="Up" Width="60" Margin="0,4,0,0" Command="{Binding MoveUpCommand}" />
              <Button Content="Down" Width="60" Margin="0,4,0,0" Command="{Binding MoveDownCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding DataContext.LearnedByText, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
        <TextBlock Text="{Binding DataContext.UsedByText, RelativeSource={RelativeSource AncestorType=skills:SkillCatalogPage}}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
