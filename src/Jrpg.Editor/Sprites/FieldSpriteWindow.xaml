<Window x:Class="Jrpg.Editor.Sprites.FieldSpriteWindow"
        x:ClassModifier="internal"
        Style="{StaticResource EditorWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:Jrpg.Editor.Viewport"
        xmlns:sprites="clr-namespace:Jrpg.Editor.Sprites"
        Title="Character sprites"
        Width="1120"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <sprites:RowIndexConverter x:Key="RowIndex" />
    <!-- The setup boxes are greyed while no image with a setup is chosen, so nothing typed is lost. -->
    <Style x:Key="EnabledWhenChosen" TargetType="Panel">
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Width" Value="110" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="70" />
    </Style>
    <Style x:Key="RowBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Width" Value="70" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Click="OnOkClicked" />
      <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom"
               Foreground="{StaticResource ProblemTextBrush}"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Text="{Binding Problem}" />

    <!-- Three columns: the images, the chosen image, its setup; the splitter widens the list for long sheet names. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="200" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="200" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- The images in the folder, set up or not, then the records without an image. -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Images (content/art/field-sprites/)" FontWeight="Bold" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
          <Button Content="Import..."
                  Width="90"
                  HorizontalAlignment="Left"
                  Click="OnImportClicked"
                  ToolTip="Copy PNGs into the field-sprite art; one already there is replaced after a question. Not undone." />
          <TextBlock x:Name="ImportStatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
          <TextBlock Text="Copy setup from" Margin="0,8,0,0" />
          <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Copy"
                    Width="60"
                    Margin="4,0,0,0"
                    Click="OnCopySetupClicked"
                    ToolTip="The chosen image takes this one's frame size, scale, feet and walk." />
            <ComboBox x:Name="CopySourceBox" ItemsSource="{Binding CopySources}" />
          </DockPanel>
        </StackPanel>
        <!-- A long name wraps rather than hiding its "(not set up)" past the edge. -->
        <ListBox ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding Chosen}"
                 Margin="0,4,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" Margin="4,0,0,0" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

      <!-- The chosen image's setup, and the four facings walking as the game draws them, over a 48 px cell outline. -->
      <StackPanel Grid.Column="3" Width="330" Margin="12,0,0,0" DataContext="{Binding Setup}" Style="{StaticResource EnabledWhenChosen}">
        <TextBlock Text="{Binding File, FallbackValue=Setup}" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Columns" Style="{StaticResource FieldLabel}" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Rows" Margin="12,0,0,0" VerticalAlignment="Center" />
          <TextBox Style="{StaticResource FieldBox}" Margin="8,0,0,0" Text="{Binding Rows, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}">
          <Run Text="Frame" /><Run Text="{Binding FrameWidth, Mode=OneWay}" /><Run Text="x" /><Run Text="{Binding FrameHeight, Mode=OneWay}" /><Run Text="px" />
        </TextBlock>
        <TextBlock Text="Walk rows (as numbered on the image)" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="Down" Style="{StaticResource FieldLabel}" />
          <ComboBox Style="{StaticResource RowBox}" ItemsSource="{Binding RowChoices}" SelectedIndex="{Binding Walk.DownRow, Converter={StaticResource RowIndex}}" />
          <TextBlock Text="Up" Margin="12,0,8,0" VerticalAlignment="Center" />
          <ComboBox Style="{StaticResource RowBox}" ItemsSource="{Binding RowChoices}" SelectedIndex="{Binding Walk.UpRow, Converter={StaticResource RowIndex}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="Left" Style="{StaticResource FieldLabel}" />
          <ComboBox Style="{StaticResource RowBox}" ItemsSource="{Binding RowChoices}" SelectedIndex="{Binding Walk.LeftRow, Converter={StaticResource RowIndex}}" />
          <TextBlock Text="Right" Margin="12,0,8,0" VerticalAlignment="Center" />
          <ComboBox Style="{StaticResource RowBox}" ItemsSource="{Binding RowChoices}" SelectedIndex="{Binding Walk.RightRow, Converter={StaticResource RowIndex}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Walk frames" Style="{StaticResource FieldLabel}" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Walk.Frames, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Frame time (ms)" Margin="12,0,8,0" VerticalAlignment="Center" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Walk.FrameMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Scale" Style="{StaticResource FieldLabel}" ToolTip="Whole number; 3 for 16 px sheets in 48 px cells" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Feet (px)" Margin="12,0,8,0" VerticalAlignment="Center" ToolTip="Sheet pixels between the frame's bottom and the feet" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding FeetPixels, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Foreground="{StaticResource ProblemTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Problem}" />
        <TextBlock Text="Walking: down, left, right, up" FontWeight="Bold" Margin="0,10,0,0" />
        <Image x:Name="Preview"
               Stretch="None"
               HorizontalAlignment="Left"
               Margin="0,4,0,0"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </StackPanel>

      <!-- The image with its frame grid, zoomable; the rows numbered from 1 on its left edge. -->
      <DockPanel Grid.Column="2" Margin="8,0,0,0">
        <viewport:CellZoomBar x:Name="ZoomBar" DockPanel.Dock="Top" Margin="0,0,0,4" HorizontalAlignment="Left" />
        <ScrollViewer x:Name="ImageScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ViewportBackgroundBrush}">
          <Grid x:Name="ImageView"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Image x:Name="SheetImage" Stretch="Fill" />
            <Image x:Name="SheetMarks" Stretch="Fill" />
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
