<UserControl x:Class="Jrpg.Editor.Tiles.TileBrowserView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </UserControl.Resources>
  <DockPanel>
    <ComboBox DockPanel.Dock="Top"
              Margin="0,4"
              ItemsSource="{Binding SheetChoices}"
              SelectedItem="{Binding SelectedChoice}"
              DisplayMemberPath="Label" />
    <Button DockPanel.Dock="Top"
            Margin="0,0,0,4"
            HorizontalAlignment="Left"
            Padding="8,2"
            Content="Set up"
            ToolTip="Make this image a sheet: id from its file name, cut into square tiles of a guessed size."
            Command="{Binding SetUpSheetCommand}"
            Visibility="{Binding CanSetUpSheet, Converter={StaticResource VisibleWhenTrue}}" />
    <TextBlock DockPanel.Dock="Bottom" Margin="0,4" Text="{Binding ChoiceText}" />
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="#202020">
      <!-- Sized in the sheet's own pixels and scaled as a whole, so a click's position is a sheet pixel. -->
      <Grid x:Name="SheetView"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            MouseLeftButtonDown="OnSheetClicked">
        <Image x:Name="SheetImage" Stretch="Fill" />
        <Image x:Name="SheetMarks" Stretch="Fill" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
