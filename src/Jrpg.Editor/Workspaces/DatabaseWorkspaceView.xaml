<UserControl x:Class="Jrpg.Editor.Workspaces.DatabaseWorkspaceView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ViewportBackgroundBrush}">
  <!-- A placeholder until the pages move here (the mode bar plan's WS5); the refusal moves into its bar then. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock HorizontalAlignment="Center"
               Foreground="{StaticResource MutedTextBrush}"
               Text="The Database editors open from the Database menu until they move here." />
    <TextBlock HorizontalAlignment="Center"
               MaxWidth="640"
               TextWrapping="Wrap"
               Foreground="{StaticResource ProblemTextBrush}"
               Text="{Binding DatabaseWorkspace.Refusal}" />
  </StackPanel>
</UserControl>
