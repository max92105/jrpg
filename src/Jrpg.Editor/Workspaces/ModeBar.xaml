<UserControl x:Class="Jrpg.Editor.Workspaces.ModeBar"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{StaticResource PanelBackgroundBrush}">
  <!-- On the main window's view model: each button's Tag says whether its half is shown, which lights it. -->
  <UserControl.Resources>
    <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="Margin" Value="2" />
      <Style.Triggers>
        <Trigger Property="Tag">
          <Trigger.Value>
            <sys:Boolean>True</sys:Boolean>
          </Trigger.Value>
          <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
          <Setter Property="FontWeight" Value="Bold" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel Orientation="Horizontal" Margin="2,0,6,0">
    <Button Style="{StaticResource ModeButton}"
            Content="World"
            ToolTip="The maps, their tiles, objects and events (Ctrl+Shift+W)"
            Tag="{Binding IsWorldShown}"
            Command="{Binding ShowWorldCommand}" />
    <Button Style="{StaticResource ModeButton}"
            Content="Database"
            ToolTip="The catalogs: quests, shops, items, enemies... (Ctrl+Shift+D)"
            Tag="{Binding IsDatabaseShown}"
            Command="{Binding ShowDatabaseCommand}" />
  </StackPanel>
</UserControl>
