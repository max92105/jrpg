<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jrpg.Core\Jrpg.Core.csproj" />
    <ProjectReference Include="..\..\src\Jrpg.Data\Jrpg.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\content\**" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestContent\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The art ArtReferenceCheck checks; the legacy folders until the content cutover (slice 10, ADR 0009). -->
    <None Include="..\..\Assets\Tiles\*.png" LinkBase="legacy-art\Tiles" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\player.png" Link="legacy-art\player.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
